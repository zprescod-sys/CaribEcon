{
  "extends": "astro/tsconfigs/strict",
  // excel-addin/ is a separate npm project with its own tsconfig, deps, and webpack build —
  // it is not part of the Astro site. Without this exclude, `astro check` walks its dist/
  // bundle and the minified single-line output exhausts the TS compiler's heap (SIGABRT).
  // public/addin/ is that same bundle published for the site to serve (npm run build:addin),
  // so it has to be excluded for the identical reason.
  "exclude": ["excel-addin", "public/addin", "dist", "node_modules"],
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"],
      "@styles/*": ["src/styles/*"],
      "@data/*": ["data/*"]
    }
  }
}
