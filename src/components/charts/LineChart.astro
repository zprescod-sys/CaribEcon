---
// Interactive line chart — D3, client-side.
// Renders a placeholder; JS draws the chart after controls fire events.
// Supports: multi-country series, hover tooltips, click-year → year-in-focus panel.

import type { IndicatorSeries } from '../../lib/types';
import { getCountries } from '../../lib/dataHub';

interface Props {
  initialSeries: IndicatorSeries[];
  initialIndicator: string;
}

const { initialSeries, initialIndicator } = Astro.props;
const seriesJSON = JSON.stringify(initialSeries);
// Country display names for the stats strip (code → name)
const namesJSON = JSON.stringify(Object.fromEntries(getCountries().map(c => [c.code, c.name])));
---

<div class="line-chart-wrapper">
  <div class="chart-title-row" id="chart-title-row">
    <div>
      <h3 class="chart-heading" id="chart-heading">—</h3>
      <p class="chart-subheading mono" id="chart-subheading">Select an indicator</p>
    </div>
    <button class="btn export-btn mono" id="csv-export-btn" aria-label="Export current chart data as CSV">
      Export CSV
    </button>
  </div>

  <div class="chart-stats-row mono" id="chart-stats" hidden></div>

  <div
    id="line-chart"
    class="chart-canvas"
    role="img"
    aria-label="Economic indicator line chart"
  >
    <div class="chart-loading mono">Rendering chart…</div>
  </div>

  <div id="chart-source" class="source-line" style="display:none"></div>
</div>

<!-- Pass server-side data to client script via data attribute -->
<div id="chart-data" data-series={seriesJSON} data-indicator={initialIndicator} data-names={namesJSON} hidden></div>

<script>
  import * as d3 from 'd3';
  import { downloadCSV } from './csvExport';
  import type { IndicatorSeries, IndicatorPoint } from '../../lib/types';

  const SERIES_COLORS: Record<string, string> = {
    GY: '#0E5E4E', // teal
    TT: '#BC8A2E', // gold
    BB: '#1E3A5F', // navy
    JM: '#A8542E', // rust
    BS: '#6A4A6E', // plum
    BZ: '#3A6B4A', // forest
    SR: '#8B5E3C', // sienna
    GD: '#4A5A8B', // slate blue
    LC: '#6B4A2E', // terra cotta
    AG: '#5A7A3A', // olive
    KN: '#7A4A5A', // mauve
    DM: '#3A5A6B', // steel teal
    VC: '#8B4A3A', // brick
    TC: '#4A6B8B', // mid blue
    KY: '#6B8B4A', // sage
    VG: '#8B6B4A', // camel
  };
  const FALLBACK_COLORS = ['#5A6B6E', '#5C6B3A', '#9A5B2E'];

  // ── State ──────────────────────────────────────────────────────────────
  const dataEl = document.getElementById('chart-data') as HTMLElement;
  let allSeries: IndicatorSeries[] = JSON.parse(dataEl.dataset.series ?? '[]');
  let currentIndicator = dataEl.dataset.indicator ?? 'gdp_growth';
  let activeCountries  = allSeries.map(s => s.country);
  const COUNTRY_NAMES: Record<string, string> = JSON.parse(dataEl.dataset.names ?? '{}');

  // Zero out animation durations for users who prefer reduced motion
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const D = (ms: number) => reduceMotion ? 0 : ms;

  // ── Formatting helpers ──────────────────────────────────────────────────
  // Large values (e.g. FDI in USD mn) get separators; small ones one decimal
  const fmtVal  = (v: number) => Math.abs(v) >= 1000 ? d3.format(',.0f')(v) : v.toFixed(1);
  const fmtTick = (v: number) => Math.abs(v) >= 1000 ? d3.format('~s')(v)   : String(v);

  // ── Stats strip: per-country cells + labeled range block on the right ────
  function updateStatsRow(filtered: IndicatorSeries[]) {
    const statsEl = document.getElementById('chart-stats');
    if (!statsEl) return;

    const cells = filtered.map((s, i) => {
      const pts  = s.series.filter(p => p.value !== null);
      const last = pts[pts.length - 1];
      const prev = pts[pts.length - 2];
      if (!last) return '';
      const color = SERIES_COLORS[s.country] ?? FALLBACK_COLORS[i % FALLBACK_COLORS.length];
      let deltaHtml = '';
      if (prev) {
        const delta = (last.value as number) - (prev.value as number);
        const dir   = delta >= 0 ? 'pos' : 'neg';
        deltaHtml = `<span class="stat-delta mono ${dir}">${delta >= 0 ? '▲' : '▼'} ${delta >= 0 ? '+' : '−'}${fmtVal(Math.abs(delta))}</span>`;
      }
      return `<div class="stat-cell">
        <span class="stat-dot" style="background:${color}"></span>
        <div class="stat-cell-body">
          <span class="stat-cell-name mono">${COUNTRY_NAMES[s.country] ?? s.country}</span>
          <span class="stat-cell-data"><span class="stat-cell-value">${fmtVal(last.value as number)}</span>${deltaHtml}</span>
        </div>
      </div>`;
    }).join('');

    const vals = filtered.flatMap(s => s.series.filter(p => p.value !== null).map(p => p.value as number));
    const range = vals.length
      ? `<span class="range-label">Range</span><span class="range-dash">—</span>
         <span class="range-stat">High <strong>${fmtVal(Math.max(...vals))}</strong></span>
         <span class="range-div">/</span>
         <span class="range-stat">Low <strong>${fmtVal(Math.min(...vals))}</strong></span>`
      : '';

    statsEl.innerHTML = `<div class="stats-left">${cells}</div><div class="stats-right mono">${range}</div>`;
    statsEl.hidden = false;
  }

  // ── Chart draw ──────────────────────────────────────────────────────────
  function drawChart() {
    const container = document.getElementById('line-chart');
    const headingEl  = document.getElementById('chart-heading');
    const subheadEl  = document.getElementById('chart-subheading');
    const sourceEl   = document.getElementById('chart-source');
    if (!container) return;

    const filtered = allSeries.filter(
      s => s.indicator === currentIndicator && activeCountries.includes(s.country)
    );
    if (filtered.length === 0) {
      container.innerHTML = '<div class="chart-loading mono">No data for selection.</div>';
      return;
    }

    const first = filtered[0];
    if (headingEl) headingEl.textContent = first.indicatorLabel;
    if (subheadEl) subheadEl.textContent = `${first.unit} · annual data`;
    if (sourceEl) {
      sourceEl.style.display = 'flex';
      // Cite every distinct source across the displayed series — a chart can mix a
      // primary national source (e.g. T&T MoF growth) with IMF/WB comparable data
      // (e.g. Guyana growth from IMF WEO), so a single citation would be misleading.
      const seen = new Set<string>();
      const uniq = filtered.filter(s => {
        const k = `${s.source}|${s.sourceUrl}`;
        if (seen.has(k)) return false;
        seen.add(k); return true;
      });
      const links = uniq
        .map(s => `<a href="${s.sourceUrl}" target="_blank" rel="noopener noreferrer">${s.source}</a>`)
        .join(' · ');
      sourceEl.innerHTML = `<span>Source${uniq.length > 1 ? 's' : ''}:</span> ${links}`;
    }

    updateStatsRow(filtered);

    const margin = { top: 18, right: 40, bottom: 40, left: 52 };
    const w = container.clientWidth  - margin.left - margin.right;
    const h = Math.min(340, Math.max(220, container.clientWidth * 0.38)) - margin.top - margin.bottom;

    container.innerHTML = '';

    const svgRoot = d3.select(container)
      .append('svg')
      .attr('width',  w + margin.left + margin.right)
      .attr('height', h + margin.top  + margin.bottom);

    // Defs: dot-grid backdrop pattern
    const defs = svgRoot.append('defs');
    defs.append('pattern')
      .attr('id', 'plot-dot-grid')
      .attr('width', 18).attr('height', 18)
      .attr('patternUnits', 'userSpaceOnUse')
      .append('circle')
      .attr('cx', 9).attr('cy', 9).attr('r', 1)
      .attr('fill', 'rgba(15,35,30,0.10)');

    const svg = svgRoot.append('g')
      .attr('transform', `translate(${margin.left},${margin.top})`);

    // Subtle dotted texture behind the plot area
    svg.append('rect')
      .attr('width', w).attr('height', h)
      .attr('fill', 'url(#plot-dot-grid)');

    const allYears = [...new Set(filtered.flatMap(s => s.series.map(d => d.year)))].sort();
    const allVals  = filtered.flatMap(s => s.series.filter(d => d.value !== null).map(d => d.value as number));

    const xScale = d3.scalePoint<number>()
      .domain(allYears)
      .range([0, w])
      .padding(0.1);

    // Small headroom so lines never touch the frame
    const [vMin, vMax] = d3.extent(allVals) as [number, number];
    const vPad = (vMax - vMin) * 0.08 || 1;
    const yScale = d3.scaleLinear()
      .domain([vMin - vPad, vMax + vPad])
      .range([h, 0])
      .nice();

    // Grid — dashed, horizontal only
    svg.append('g')
      .call(d3.axisLeft(yScale).tickSize(-w).tickFormat('' as any).ticks(5))
      .call(g => {
        g.select('.domain').remove();
        g.selectAll('.tick line')
          .attr('stroke', 'rgba(15,35,30,0.08)')
          .attr('stroke-dasharray', '3,3');
      });

    // Zero baseline when the domain crosses it (e.g. contraction years)
    const [d0, d1] = yScale.domain();
    if (d0 < 0 && d1 > 0) {
      svg.append('line')
        .attr('x1', 0).attr('x2', w)
        .attr('y1', yScale(0)).attr('y2', yScale(0))
        .attr('stroke', 'rgba(15,35,30,0.28)');
    }

    // Axes — no axis lines, generous tick padding
    svg.append('g')
      .attr('transform', `translate(0,${h})`)
      .call(d3.axisBottom(xScale).tickFormat(d => String(d)).tickPadding(12))
      .call(g => {
        g.select('.domain').remove();
        g.selectAll('text').attr('font-family', 'JetBrains Mono, monospace').attr('font-size', '10').attr('fill', '#8A958F');
        g.selectAll('.tick line').remove();
      });

    svg.append('g')
      .call(d3.axisLeft(yScale).ticks(5).tickFormat(d => fmtTick(Number(d))).tickPadding(8))
      .call(g => {
        g.select('.domain').remove();
        g.selectAll('text').attr('font-family', 'JetBrains Mono, monospace').attr('font-size', '10').attr('fill', '#8A958F');
        g.selectAll('.tick line').remove();
      });

    // Tooltip (shared by the hover crosshair)
    const tooltip = d3.select(container)
      .append('div')
      .attr('class', 'chart-tooltip')
      .style('display', 'none');

    const line = d3.line<IndicatorPoint>()
      .defined(d => d.value !== null)
      .x(d => xScale(d.year)!)
      .y(d => yScale(d.value as number))
      .curve(d3.curveMonotoneX);

    // Draw series
    filtered.forEach((series, i) => {
      const color = SERIES_COLORS[series.country] ?? FALLBACK_COLORS[i % FALLBACK_COLORS.length];
      const validPoints = series.series.filter(d => d.value !== null);

      // Dashed segment for estimates/projections
      const actualPoints = validPoints.filter(d => d.type === 'actual');
      const nonActualPoints = validPoints.filter(d => d.type !== 'actual');

      if (actualPoints.length > 0) {
        const path = svg.append('path').datum(actualPoints)
          .attr('fill', 'none').attr('stroke', color).attr('stroke-width', 2)
          .attr('d', line as any);

        // Draw-in animation, left to right
        const len = (path.node() as SVGPathElement).getTotalLength();
        path.attr('stroke-dasharray', `${len} ${len}`)
          .attr('stroke-dashoffset', len)
          .transition().duration(D(650)).ease(d3.easeCubicOut)
          .attr('stroke-dashoffset', 0)
          .on('end', function () { d3.select(this).attr('stroke-dasharray', null); });
      }

      if (nonActualPoints.length > 0) {
        // Include last actual point to connect the line
        const bridge = actualPoints.slice(-1).concat(nonActualPoints);
        svg.append('path').datum(bridge)
          .attr('fill', 'none').attr('stroke', color).attr('stroke-width', 2)
          .attr('stroke-dasharray', '4,3')
          .attr('d', line as any)
          .attr('opacity', 0)
          .transition().duration(D(300)).delay(D(550))
          .attr('opacity', 0.7);
      }

      // Dots — gold for non-actuals; hover/click is handled by the overlay
      svg.selectAll(`.dot-${series.country}`)
        .data(validPoints)
        .join('circle')
        .attr('cx', d => xScale(d.year)!)
        .attr('cy', d => yScale(d.value as number))
        .attr('r', 0)
        .attr('fill', d => d.type !== 'actual' ? '#BC8A2E' : color)
        .attr('stroke', 'var(--card)').attr('stroke-width', 1.5)
        .transition().duration(D(250)).delay((_, j) => D(250 + j * 40))
        .attr('r', 3);

      // Emphasised end point + country label
      const last = validPoints[validPoints.length - 1];
      if (last) {
        svg.append('circle')
          .attr('cx', xScale(last.year)!)
          .attr('cy', yScale(last.value as number))
          .attr('r', 0)
          .attr('fill', last.type !== 'actual' ? '#BC8A2E' : color)
          .attr('stroke', 'var(--card)').attr('stroke-width', 2)
          .transition().duration(D(250)).delay(D(600))
          .attr('r', 4.5);

        svg.append('text')
          .attr('x', xScale(last.year)! + 8)
          .attr('y', yScale(last.value as number) + 4)
          .attr('font-family', 'JetBrains Mono, monospace')
          .attr('font-size', '10')
          .attr('font-weight', '600')
          .attr('fill', color)
          .attr('opacity', 0)
          .text(series.country)
          .transition().duration(D(300)).delay(D(650))
          .attr('opacity', 1);
      }
    });

    // ── Hover crosshair: vertical guide, active dots, unified tooltip ─────
    const focus = svg.append('g').style('display', 'none');
    focus.append('line')
      .attr('class', 'crosshair')
      .attr('y1', 0).attr('y2', h)
      .attr('stroke', 'rgba(15,35,30,0.35)')
      .attr('stroke-dasharray', '4,4');

    const activeDots = filtered.map((s, i) => focus.append('circle')
      .attr('r', 5)
      .attr('fill', SERIES_COLORS[s.country] ?? FALLBACK_COLORS[i % FALLBACK_COLORS.length])
      .attr('stroke', 'var(--card)')
      .attr('stroke-width', 2));

    function nearestYear(mx: number): number {
      let best = allYears[0], bestDist = Infinity;
      for (const y of allYears) {
        const dist = Math.abs((xScale(y) ?? 0) - mx);
        if (dist < bestDist) { bestDist = dist; best = y; }
      }
      return best;
    }

    // Transparent capture layer on top of everything in the plot area
    svg.append('rect')
      .attr('width', w).attr('height', h)
      .attr('fill', 'transparent')
      .style('cursor', 'pointer')
      .on('mouseenter', () => focus.style('display', null))
      .on('mouseleave', () => {
        focus.style('display', 'none');
        tooltip.style('display', 'none');
      })
      .on('mousemove', (event) => {
        const [mx] = d3.pointer(event);
        const year = nearestYear(mx);
        const x = xScale(year)!;
        focus.select('line').attr('x1', x).attr('x2', x);

        const rows = filtered.map((s, i) => {
          const pt  = s.series.find(p => p.year === year);
          const dot = activeDots[i];
          if (!pt || pt.value === null) { dot.style('display', 'none'); return ''; }
          dot.style('display', null).attr('cx', x).attr('cy', yScale(pt.value));
          const color = SERIES_COLORS[s.country] ?? FALLBACK_COLORS[i % FALLBACK_COLORS.length];
          return `<div class="tt-row">
            <span class="tt-dot" style="background:${color}"></span>
            <span class="tt-name">${s.country}</span>
            <span class="tt-val">${fmtVal(pt.value)}${pt.type !== 'actual' ? ` <span class="tt-type">${pt.type}</span>` : ''}</span>
          </div>`;
        }).join('');

        tooltip.style('display', 'block')
          .html(`<div class="tt-year">${year} · ${first.unit}</div>${rows}<div class="tt-hint">click for year in focus</div>`);

        // Flip to the left of the crosshair near the right edge
        const ttw  = (tooltip.node() as HTMLElement).offsetWidth;
        const left = x > w * 0.62 ? margin.left + x - ttw - 14 : margin.left + x + 14;
        tooltip.style('left', `${left}px`).style('top', `${margin.top + 8}px`);
      })
      .on('click', (event) => {
        const [mx] = d3.pointer(event);
        openYearInFocus(nearestYear(mx), allSeries);
      });
  }

  // ── Year-in-focus panel ────────────────────────────────────────────────
  const YEAR_EVENTS: Record<number, string> = {
    2015: 'Oil-price collapse weighs on energy exporters (T&T, Suriname); ExxonMobil announces the Liza discovery offshore Guyana.',
    2016: 'Regional recovery from the commodity downturn; Caribbean tourism arrivals reach record highs.',
    2017: 'Hurricanes Irma and Maria devastate the northern Caribbean; Dominica and Barbuda suffer severe damage.',
    2018: 'Barbados enters an IMF programme and launches a comprehensive debt restructuring.',
    2019: 'Guyana brings first oil on-stream (Liza Phase 1, December); regional growth steady pre-pandemic.',
    2020: 'COVID-19 pandemic; tourism-dependent economies contract sharply while Guyana begins commercial oil production.',
    2021: 'Post-COVID recovery; Guyana\'s oil ramp-up accelerates with Liza Phase 1 reaching plateau.',
    2022: 'Global commodity price spike (Russia-Ukraine war); Guyana GDP surges 63.3% — world\'s fastest growth.',
    2023: 'Liza Phase 2 and Payara developments progress; T&T signs new upstream exploration agreements.',
    2024: 'Yellowtail FPSO on track; Guyana Natural Resource Fund surpasses USD 2bn.',
    2025: 'IMF projections (April 2026 WEO): Guyana growth moderates from peak; regional debt ratios edge lower.',
  };

  function openYearInFocus(year: number, series: IndicatorSeries[]) {
    const panel  = document.getElementById('year-in-focus') as HTMLElement | null;
    const yearEl  = document.getElementById('yif-year');
    const eventEl = document.getElementById('yif-event');
    const hlEl    = document.getElementById('yif-headlines');
    if (!panel || !yearEl || !eventEl || !hlEl) return;

    yearEl.textContent  = String(year);
    eventEl.textContent = YEAR_EVENTS[year] ?? 'No notable event recorded for this year.';

    // Show values for the active indicator only (not all indicators)
    const rows = series
      .filter(s => activeCountries.includes(s.country) && s.indicator === currentIndicator)
      .map((s, i) => {
        const pt = s.series.find(d => d.year === year);
        if (!pt || pt.value === null) return null;
        const color = SERIES_COLORS[s.country] ?? FALLBACK_COLORS[i % FALLBACK_COLORS.length];
        const typeTag = pt.type !== 'actual'
          ? `<span class="yif-type">${pt.type}</span>` : '';
        return `<div class="yif-headline-item">
          <span class="yif-dot" style="background:${color}"></span>
          <div>
            <span class="yif-country">${COUNTRY_NAMES[s.country] ?? s.country}</span>
            <span class="yif-val">${fmtVal(pt.value)} <span class="yif-unit">${s.unit}</span>${typeTag}</span>
          </div>
        </div>`;
      })
      .filter(Boolean);

    hlEl.innerHTML = rows.join('') || '<p class="mono" style="font-size:11px;color:var(--ink-faint)">No data for this year.</p>';
    panel.hidden = false;
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ── Event listeners ────────────────────────────────────────────────────
  document.addEventListener('countries-changed', (e: Event) => {
    const evt = e as CustomEvent<{ countries: string[] }>;
    activeCountries = evt.detail.countries;
    drawChart();
  });

  document.addEventListener('indicator-changed', (e: Event) => {
    const evt = e as CustomEvent<{ indicator: string }>;
    currentIndicator = evt.detail.indicator;
    drawChart();
    // Refresh the YIF panel if it's open so data matches the new indicator
    const yif = document.getElementById('year-in-focus') as HTMLElement | null;
    const yearEl = document.getElementById('yif-year');
    if (yif && !yif.hidden && yearEl?.textContent) {
      openYearInFocus(Number(yearEl.textContent), allSeries);
    }
  });

  // CSV export
  document.getElementById('csv-export-btn')?.addEventListener('click', () => {
    const filtered = allSeries.filter(
      s => s.indicator === currentIndicator && activeCountries.includes(s.country)
    );
    const rows = filtered.flatMap(s =>
      s.series
        .filter(d => d.value !== null)
        .map(d => ({
          country: s.country,
          indicator: s.indicator,
          indicator_label: s.indicatorLabel,
          unit: s.unit,
          year: d.year,
          value: d.value,
          type: d.type,
          source: s.source,
          vintage: d.vintage,
        }))
    );
    downloadCSV(rows, `caribbean-macro-${currentIndicator}`);
  });

  // Redraw on resize so the chart stays crisp at any width
  let resizeTimer: ReturnType<typeof setTimeout> | undefined;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(drawChart, 150);
  });

  // Initial render
  drawChart();
</script>

<style>
  .line-chart-wrapper {
    border: var(--border);
    background-color: var(--card);
  }

  .chart-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 16px 16px 0;
    gap: var(--gap-md);
    flex-wrap: wrap;
  }

  .chart-heading {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 2px;
  }

  .chart-subheading {
    color: var(--ink-faint);
    font-size: 10px;
    letter-spacing: 0.05em;
  }

  .export-btn {
    margin-top: 4px;
    font-size: 10px;
  }

  .chart-stats-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 28px;
    padding: 14px 16px 2px;
  }

  .chart-stats-row :global(.stats-left) {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .chart-stats-row :global(.stat-cell) {
    display: flex;
    align-items: flex-start;
    gap: 9px;
  }

  .chart-stats-row :global(.stat-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    margin-top: 3px;
    flex-shrink: 0;
  }

  .chart-stats-row :global(.stat-cell-body) {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .chart-stats-row :global(.stat-cell-name) {
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--ink-faint);
  }

  .chart-stats-row :global(.stat-cell-data) {
    display: flex;
    align-items: baseline;
    gap: 9px;
  }

  .chart-stats-row :global(.stat-cell-value) {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .chart-stats-row :global(.stat-delta) {
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .chart-stats-row :global(.stat-delta.pos) { color: var(--pos); }
  .chart-stats-row :global(.stat-delta.neg) { color: var(--neg); }

  .chart-stats-row :global(.stats-right) {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 11px;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .chart-stats-row :global(.range-label) {
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 10px;
  }

  .chart-stats-row :global(.range-dash),
  .chart-stats-row :global(.range-div) { color: var(--line); }

  .chart-stats-row :global(.range-stat strong) {
    color: var(--ink-soft);
