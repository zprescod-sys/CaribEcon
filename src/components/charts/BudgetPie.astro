---
// Budget donut chart — D3.
// Centre shows total budget by default; hover shows a category; click pins it
// and fills the drill-down projects panel. A synced legend sits beside the donut.

import type { BudgetEntry } from '../../lib/types';

interface Props {
  budget: BudgetEntry;
  /** Display name for the country; falls back to the country code if omitted. */
  countryName?: string;
}

const { budget, countryName } = Astro.props;
const displayName = countryName ?? budget.country;
const budgetJSON = JSON.stringify(budget);
---

<div class="budget-pie-wrapper">
  <div class="budget-pie-header">
    <div>
      <span class="eyebrow">Budget {budget.fiscalYear}</span>
      <h3 class="budget-title">{displayName} — Budget Allocation</h3>
      <p class="budget-denominator mono">
        Denominator: {budget.currencySymbol}{budget.total.toLocaleString('en-US')}mn — {budget.denominator}
      </p>
    </div>
    <div class="source-line">
      <span>Source:</span>
      <a href={budget.sourceUrl} target="_blank" rel="noopener noreferrer">{budget.source} — {budget.sourceDocument}</a>
      <span>· {budget.sourcePage}</span>
    </div>
  </div>

  <!-- Basis + coverage: what the denominator measures and how complete the
       segmentation is. Stated up front so a reader never has to infer it. -->
  <details class="budget-basis">
    <summary class="mono">Basis &amp; coverage</summary>
    <p><strong>Basis.</strong> {budget.basis}</p>
    <p><strong>Coverage.</strong> {budget.coverage}</p>
    {budget.note && <p><strong>Note.</strong> {budget.note}</p>}
    <p class="budget-basis-cur mono">
      All figures in {budget.currency} millions, exactly as printed in the source. No currency conversion is applied.
    </p>
  </details>

  <div class="budget-layout">
    <!-- Donut chart -->
    <div id={`pie-chart-${budget.country}`} class="pie-container" role="img" aria-label={`Budget allocation donut chart for ${budget.country}`}></div>

    <!-- Synced legend -->
    <div id={`pie-legend-${budget.country}`} class="pie-legend" role="list" aria-label="Budget categories"></div>
  </div>

  <!-- Drill-down projects panel -->
  <div class="projects-panel" id={`projects-${budget.country}`}>
    <p class="projects-prompt mono">Click a segment or legend row to see its amount, share and source page</p>
  </div>
</div>

<!-- Unique class used by the script to find all budget pie instances on the page -->
<div class="budget-pie-data" data-country={budget.country} data-budget={budgetJSON} hidden></div>

<script>
  import * as d3 from 'd3';
  import type { BudgetEntry, BudgetCategory } from '../../lib/types';

  /* A segment as drawn. `amount` is local-currency millions straight from the
     source; `pct` is computed here from the segment sum, never stored — the
     old data carried hand-written integer percentages that were the only real
     input, which is what let unsourced splits masquerade as source figures. */
  interface Segment extends BudgetCategory {
    pct: number;
    grouped?: BudgetCategory[];   // set on the display-only "other ministries" roll-up
  }
  type Slice = d3.PieArcDatum<Segment>;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DUR   = reduceMotion ? 0 : 200;  // interaction transitions
  const ENTER = reduceMotion ? 0 : 550;  // entrance sweep

  // Beyond this many segments a pie stops being readable; the smallest are
  // rolled into one disclosed slice. The .xlsx export always carries every row.
  const MAX_SLICES = 12;
  const KEEP_SLICES = 10;

  // "TT$59.7bn" / "TT$750mn" — local currency, never converted
  const fmtLocal = (v: number, sym: string) =>
    v >= 1000
      ? `${sym}${(v / 1000).toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}bn`
      : `${sym}${Math.round(v).toLocaleString('en-US')}mn`;

  // Initialize every budget pie on this page
  document.querySelectorAll<HTMLElement>('.budget-pie-data').forEach(dataEl => {
    const country = dataEl.dataset.country!;
    const budget: BudgetEntry = JSON.parse(dataEl.dataset.budget ?? '{}');

    const container = document.getElementById(`pie-chart-${country}`);
    const legendEl  = document.getElementById(`pie-legend-${country}`);
    const panel     = document.getElementById(`projects-${country}`);
    if (!container || !legendEl || !panel) return;

    const COLORS = ['#0E5E4E','#BC8A2E','#1E3A5F','#A8542E','#6A4A6E','#5A6B6E','#5C6B3A','#9A5B2E'];
    const size   = Math.min(container.clientWidth || 260, 260);
    const radius = size / 2;
    const inner  = radius * 0.58;

    const svg = d3.select(container)
      .append('svg')
      .attr('width', size).attr('height', size)
      .append('g')
      .attr('transform', `translate(${radius},${radius})`);

    const pie = d3.pie<Segment>()
      .value(d => d.amount)
      .sort(null)
      .padAngle(0.015);

    // Hover/pinned segments lift outward ~6px
    const arc      = d3.arc<Slice>().innerRadius(inner).outerRadius(radius - 6).cornerRadius(3);
    const arcLift  = d3.arc<Slice>().innerRadius(inner).outerRadius(radius).cornerRadius(3);

    const sym = budget.currencySymbol;

    /* Shares are computed against the sum of the segments, not the published
       total, so the slices always add to exactly 100%. Where the two differ
       (Jamaica, by 0.0075%, from the source's own rounding) the discrepancy is
       disclosed in the basis panel rather than silently absorbed. */
    const sorted   = [...budget.categories].sort((a, b) => b.amount - a.amount);
    const segTotal = sorted.reduce((s, c) => s + c.amount, 0);

    let display: BudgetCategory[] = sorted;
    if (sorted.length > MAX_SLICES) {
      const kept = sorted.slice(0, KEEP_SLICES);
      const rest = sorted.slice(KEEP_SLICES);
      display = [...kept, {
        name: `Other ministries and departments (${rest.length})`,
        slug: 'grouped-other',
        amount: rest.reduce((s, c) => s + c.amount, 0),
        sourcePage: 'see export',
        note: 'Display grouping only — these are individually published line items, listed in full in the .xlsx export.',
        grouped: rest,
      } as BudgetCategory & { grouped: BudgetCategory[] }];
    }

    const segments: Segment[] = display.map(c => ({ ...c, pct: (c.amount / segTotal) * 100 }));
    const arcData = pie(segments);
    let pinnedIndex: number | null = null;

    // ── Centre: category name / value / pct, defaulting to the total ──────
    const centreName = svg.append('text')
      .attr('text-anchor', 'middle').attr('dy', '-22')
      .attr('font-family', 'JetBrains Mono, monospace')
      .attr('font-size', '9').attr('letter-spacing', '0.5').attr('fill', '#8A958F');

    const centreValue = svg.append('text')
      .attr('text-anchor', 'middle').attr('dy', '2')
      .attr('font-family', 'Bricolage Grotesque, sans-serif')
      .attr('font-size', '20').attr('font-weight', '800').attr('fill', '#0F231E');

    const centreSub = svg.append('text')
      .attr('text-anchor', 'middle').attr('dy', '20')
      .attr('font-family', 'JetBrains Mono, monospace')
      .attr('font-size', '9').attr('fill', '#8A958F');

    function setCentre(d: Slice | null) {
      if (!d) {
        centreName.text('');
        centreValue.text(fmtLocal(budget.total, sym));
        centreSub.text('total budget');
      } else {
        const name = d.data.name;
        centreName.text(name.length > 20 ? `${name.slice(0, 19)}…` : name);
        centreValue.text(fmtLocal(d.data.amount, sym));
        centreSub.text(`${d.data.pct.toFixed(1)}% of budget`);
      }
    }
    setCentre(null);

    // ── Segments ───────────────────────────────────────────────────────────
    const paths = svg.selectAll('.arc-path')
      .data(arcData)
      .join('path')
      .attr('class', 'arc-path')
      .attr('fill', (_, i) => COLORS[i % COLORS.length])
      .attr('stroke', 'var(--card)')
      .attr('stroke-width', 1.5)
      .style('cursor', 'pointer');

    // Entrance: segments sweep open clockwise, staggered
    paths
      .transition()
      .duration(ENTER)
      .delay((_, i) => reduceMotion ? 0 : i * 55)
      .ease(d3.easeCubicOut)
      .attrTween('d', function(d) {
        const grow = d3.interpolate({ ...d, endAngle: d.startAngle }, d);
        return (t: number) => arc(grow(t)) as string;
      });

    // Percentage labels — only on slices large enough to hold them
    svg.selectAll('.arc-label')
      .data(arcData.filter(d => d.data.pct >= 10))
      .join('text')
      .attr('class', 'arc-label')
      .attr('transform', d => `translate(${arc.centroid(d)})`)
      .attr('text-anchor', 'middle').attr('dy', '0.35em')
      .attr('font-family', 'JetBrains Mono, monospace')
      .attr('font-size', '9')
      .attr('fill', 'rgba(246,247,242,0.95)')
      .style('pointer-events', 'none')
      .attr('opacity', 0)
      .text(d => `${Math.round(d.data.pct)}%`)
      .transition().duration(reduceMotion ? 0 : 300).delay(reduceMotion ? 0 : 500)
      .attr('opacity', 1);

    // ── Legend (synced with segments) ──────────────────────────────────────
    legendEl.innerHTML = arcData.map((d, i) => `
      <button class="legend-row" data-index="${d.index}" role="listitem" type="button">
        <span class="legend-swatch" style="background:${COLORS[i % COLORS.length]}"></span>
        <span class="legend-name">${d.data.name}${d.data.derived ? ' <span class="legend-flag mono">derived</span>' : ''}</span>
        <span class="legend-val mono">${fmtLocal(d.data.amount, sym)}</span>
        <span class="legend-pct mono">${d.data.pct.toFixed(1)}%</span>
      </button>
    `).join('');
    const legendRows = [...legendEl.querySelectorAll<HTMLElement>('.legend-row')];

    // ── Shared hover/pin state machine ─────────────────────────────────────
    function highlight(i: number) {
      paths.interrupt('hover').transition('hover').duration(DUR).ease(d3.easeCubicOut)
        .attr('d', p => ((p.index === i || p.index === pinnedIndex) ? arcLift(p) : arc(p)) as string)
        .attr('opacity', p => p.index === i ? 1 : 0.4);
      legendRows.forEach((r, j) => r.classList.toggle('hover', j === i));
      setCentre(arcData[i]);
    }

    // Default state: pinned segment stays lifted, centre shows pin or total
    function restore() {
      paths.interrupt('hover').transition('hover').duration(DUR).ease(d3.easeCubicOut)
        .attr('d', p => (p.index === pinnedIndex ? arcLift(p) : arc(p)) as string)
        .attr('opacity', 1);
      legendRows.forEach(r => r.classList.remove('hover'));
      setCentre(pinnedIndex !== null ? arcData[pinnedIndex] : null);
    }

    function pin(i: number) {
      pinnedIndex = i;
      legendRows.forEach((r, j) => r.classList.toggle('pinned', j === i));
      showProvenance(arcData[i].data, COLORS[i % COLORS.length], panel!, budget);
      restore();
    }

    paths
      .on('mouseenter', (_, d) => highlight(d.index))
      .on('mouseleave', restore)
      .on('click', (_, d) => pin(d.index));

    legendRows.forEach((row, i) => {
      row.addEventListener('mouseenter', () => highlight(i));
      row.addEventListener('mouseleave', restore);
      row.addEventListener('focus', () => highlight(i));
      row.addEventListener('blur', restore);
      row.addEventListener('click', () => pin(i));
    });

    // Pre-fill the drill-down with the largest segment (without pinning the
    // centre, which keeps showing the total until the user clicks)
    const largest = arcData.reduce((a, b) => (b.data.amount > a.data.amount ? b : a), arcData[0]);
    showProvenance(largest.data, COLORS[largest.index % COLORS.length], panel, budget);
  });

  /* Drill-down shows a segment's provenance: the amount as printed, its share,
     and the page it came from — so any figure on screen can be checked against
     the source document without leaving the page. */
  function showProvenance(cat: Segment, color: string, panel: HTMLElement, budget: BudgetEntry) {
    const sym = budget.currencySymbol;
    const rows: string[] = [
      `<div class="prov-row"><span class="prov-k mono">Amount</span><span class="prov-v">${sym}${cat.amount.toLocaleString('en-US')}mn</span></div>`,
      `<div class="prov-row"><span class="prov-k mono">Share of total</span><span class="prov-v">${cat.pct.toFixed(2)}%</span></div>`,
    ];

    if (cat.grouped?.length) {
      rows.push(`<div class="prov-row"><span class="prov-k mono">Composition</span><span class="prov-v">${cat.grouped.length} individually published line items, smallest ${sym}${Math.min(...cat.grouped.map(g => g.amount)).toLocaleString('en-US')}mn</span></div>`);
    } else if (cat.derived) {
      rows.push(`<div class="prov-row"><span class="prov-k mono">Provenance</span><span class="prov-v"><span class="prov-flag derived">Derived residual</span> not a published line item</span></div>`);
    } else {
      rows.push(`<div class="prov-row"><span class="prov-k mono">Source page</span><span class="prov-v"><span class="prov-flag">Transcribed</span> ${cat.sourcePage}</span></div>`);
    }

    if (cat.note) {
      rows.push(`<div class="prov-row"><span class="prov-k mono">Note</span><span class="prov-v">${cat.note}</span></div>`);
    }

    panel.innerHTML = `
      <div class="projects-category" style="border-left: 3px solid ${color}; padding-left: 12px;">
        <div class="projects-cat-header">
          <span class="eyebrow">${cat.name}</span>
          <span class="mono cat-pct">${cat.pct.toFixed(1)}% · ${fmtLocal(cat.amount, sym)}</span>
        </div>
        <div class="prov-list">${rows.join('')}</div>
      </div>
    `;

    // Gentle fade-in when content swaps
    if (!reduceMotion) {
      (panel.firstElementChild as HTMLElement | null)?.animate?.(
        [{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }],
        { duration: 240, easing: 'ease-out' }
      );
    }
  }
</script>

<style>
  .budget-pie-wrapper {
    border: var(--border);
    background-color: var(--card);
    padding: 20px;
  }

  .budget-pie-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    margin-bottom: 20px;
  }

  .budget-title {
    font-size: 16px;
    font-weight: 700;
    margin-top: 4px;
  }

  .budget-layout {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    align-items: center;
  }

  .pie-container svg { display: block; }

  /* ── Legend: swatch · name · value · pct, tabular-aligned ─────────────── */
  .pie-legend {
    display: flex;
    flex-direction: column;
  }

  .pie-legend :global(.legend-row) {
    display: grid;
    grid-template-columns: 10px 1fr auto 52px;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 6px 8px;
    border: none;
    border-top: 1px solid var(--line);
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .pie-legend :global(.legend-row:first-child) { border-top: none; }

  .pie-legend :global(.legend-row.hover),
  .pie-legend :global(.legend-row:hover) { background-color: var(--card-tint); }

  .pie-legend :global(.legend-row.pinned .legend-name) { font-weight: 600; }

  .pie-legend :global(.legend-row:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: -2px;
  }

  .pie-legend :global(.legend-swatch) {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .pie-legend :global(.legend-name) {
    font-family: var(--font-body);
    font-size: 12.5px;
    color: var(--ink);
    line-height: 1.3;
  }

  .pie-legend :global(.legend-val) {
    font-size: 11px;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .pie-legend :global(.legend-pct) {
    font-size: 11px;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  @media (prefers-reduced-motion: reduce) {
    .pie-legend :global(.legend-row) { transition: none; }
  }

  /* ── Drill-down panel below the donut + legend ────────────────────────── */
  /* ── Denominator + basis disclosure ─────────────────────────────────────── */
  .budget-denominator {
    font-size: 10px;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    margin-top: 4px;
  }

  .budget-basis {
    margin-top: 14px;
    border: 1px solid var(--line);
    padding: 10px 12px;
    background-color: var(--paper);
  }
  .budget-basis summary {
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .budget-basis summary:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  .budget-basis p {
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.6;
    margin-top: 8px;
  }
  .budget-basis strong { color: var(--ink); font-weight: 600; }
  .budget-basis-cur { font-size: 10px; color: var(--ink-faint); }

  .projects-panel {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    min-height: 120px;
  }

  .projects-prompt {
    color: var(--ink-faint);
    font-size: 11px;
  }

  :global(.projects-cat-header) {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  :global(.cat-pct) {
    color: var(--ink-faint);
    font-size: 10px;
  }

  /* ── Segment provenance rows ────────────────────────────────────────────── */
  :global(.prov-row) {
    padding: 7px 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
    align-items: baseline;
  }
  :global(.prov-k) {
    font-size: 10px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  :global(.prov-v) {
    font-size: 13px;
    color: var(--ink);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  /* Transcribed = lifted verbatim from the cited page. Derived = computed here. */
  :global(.prov-flag) {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--teal);
    color: var(--teal);
    padding: 1px 5px;
    margin-right: 6px;
  }
  :global(.prov-flag.derived) { border-color: var(--gold); color: var(--gold); }

  :global(.legend-flag) {
    font-size: 8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid var(--gold);
    padding: 0 3px;
    margin-left: 5px;
  }

  @media (max-width: 640px) {
    :global(.prov-row) { grid-template-columns: 1fr; gap: 2px; }
  }

  @media (max-width: 640px) {
    .budget-layout { grid-template-columns: 1fr; }
    .pie-container { margin: 0 auto; }
  }
</style>
