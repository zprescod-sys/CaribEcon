---
// Deals & Investment — headline list only.
import type { DealsData } from '../../lib/types';

interface Props {
  deals: DealsData;
}

const { deals } = Astro.props;

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

const sorted = [...deals].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<div class="deals-list">
  {sorted.map(deal => {
    const countries = Array.isArray(deal.country) ? deal.country : [deal.country];
    return (
      <article class="deal-item">
        <div class="deal-meta">
          <span class="badge">{deal.type}</span>
          <time class="mono" datetime={deal.date}>{formatDate(deal.date)}</time>
          {countries.map(c => <span class="badge">{c}</span>)}
          {deal.value && <span class="mono deal-value">{deal.value}</span>}
        </div>

        <a
          href={deal.url}
          target="_blank"
          rel="noopener noreferrer"
          class="deal-headline"
        >
          {deal.headline}
          <span class="deal-link-icon" aria-hidden="true">↗</span>
        </a>

        {deal.parties && (
          <span class="deal-parties mono">{deal.parties}</span>
        )}
      </article>
    );
  })}
</div>

<style>
  .deals-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: var(--gap-md);
  }

  .deal-item {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .deal-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .deal-value {
    color: var(--gold);
    font-size: 11px;
    font-weight: 500;
  }

  .deal-headline {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.4;
    max-width: 76ch;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .deal-headline:hover { color: var(--teal); text-decoration: underline; }

  .deal-link-icon { font-size: 11px; color: var(--ink-faint); flex-shrink: 0; }

  .deal-parties {
    color: var(--ink-faint);
    font-size: 10px;
    letter-spacing: 0.02em;
  }
</style>
