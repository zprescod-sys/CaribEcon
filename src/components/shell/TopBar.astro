---
// Top bar: brand left, scrolling macro ticker right.
// Ticker items are derived from the data hub at build time — never hardcoded.
import { getCountries, getSeries } from '../../lib/dataHub';

interface TickerItem {
  label: string;            // "GY · GDP"
  value: string;            // "+34.3%"
  tone: 'pos' | 'neg' | 'neutral';
  est: boolean;             // estimate/projection flag
}

// Latest non-null point of a series
function latest(country: string, indicator: string) {
  const s = getSeries(country, indicator);
  const pts = s?.series.filter(p => p.value !== null) ?? [];
  const last = pts[pts.length - 1];
  return last ? { value: last.value as number, type: last.type } : null;
}

// Every item follows the same pattern: "CC · Indicator value"
const tickerItems: TickerItem[] = getCountries().flatMap(c => {
  const items: TickerItem[] = [];
  const gdp = latest(c.code, 'gdp_growth');
  if (gdp) items.push({
    label: `${c.code} · GDP`,
    value: `${gdp.value >= 0 ? '+' : '−'}${Math.abs(gdp.value).toFixed(1)}%`,
    tone:  gdp.value >= 0 ? 'pos' : 'neg',
    est:   gdp.type !== 'actual',
  });
  const inf = latest(c.code, 'inflation');
  if (inf) items.push({
    label: `${c.code} · Inflation`,
    value: `${inf.value.toFixed(1)}%`,
    tone:  'neutral',
    est:   inf.type !== 'actual',
  });
  return items;
});

// Scroll speed scales with content so pacing stays steady as countries are added
const tickerDuration = `${tickerItems.length * 6}s`;
---

<header class="topbar">
  <div class="page-wrapper topbar-inner">
    <a href="/" class="brand" aria-label="CaribEcon home">
      <img
        class="brand-logo"
        src="/carib-econ-index-logo.svg"
        alt=""
        width="36"
        height="36"
      />
      <span class="brand-copy">
        <span class="brand-name">CaribEcon</span>
        <span class="brand-region mono">Caribbean Marco Almanac</span>
      </span>
    </a>

    <div class="ticker" aria-label="Key economic indicators" style={`--ticker-duration: ${tickerDuration}`}>
      <div class="ticker-track">
        {[0, 1].map(copy => (
          <ul class="ticker-list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {tickerItems.map(item => (
              <li class="ticker-item mono">
                <span class="ticker-label">{item.label}</span>
                <span class={`ticker-value tone-${item.tone}`}>
                  {item.value}{item.est && <sup class="ticker-est" title="Estimate / projection">est</sup>}
                </span>
                <span class="ticker-sep" aria-hidden="true">•</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  .topbar {
    background-color: var(--teal-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    height: var(--topbar-height);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--gap-md);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo {
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .brand-copy {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--paper);
    letter-spacing: -0.01em;
  }

  .brand-region {
    color: rgba(236, 238, 232, 0.5);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .ticker {
    overflow: hidden;
    flex: 1;
    max-width: 560px;
    mask-image: linear-gradient(to right, transparent, black 48px, black calc(100% - 48px), transparent);
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll var(--ticker-duration, 24s) linear infinite;
  }

  /* Pause so a value can actually be read */
  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }

  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .ticker-list {
    display: flex;
    list-style: none;
    align-items: center;
    height: var(--topbar-height);
  }

  .ticker-item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
  }

  .ticker-label {
    color: rgba(236, 238, 232, 0.55);
    font-size: 10px;
    letter-spacing: 0.05em;
  }

  .ticker-value {
    color: var(--paper);
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Brightened semantic tones — checked against the dark band */
  .ticker-value.tone-pos { color: #5FB88A; }
  .ticker-value.tone-neg { color: #E0917B; }

  .ticker-est {
    color: #D9B36A;
    font-size: 8px;
    letter-spacing: 0.04em;
    margin-left: 2px;
  }

  .ticker-sep {
    color: rgba(236, 238, 232, 0.25);
    font-size: 10px;
    margin: 0 16px;
  }

  /* Reduced motion: static row, no scroll, no duplicate copy */
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; width: 100%; justify-content: flex-end; }
    .ticker-list[aria-hidden] { display: none; }
    .ticker { mask-image: none; }
    .ticker-item:last-child .ticker-sep { display: none; }
  }

  @media (max-width: 640px) {
    .ticker { display: none; }
    .brand-region { display: none; }
    .brand-copy { gap: 0; }
  }
</style>
