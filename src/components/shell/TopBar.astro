---
// Top bar: brand left, data ticker right
const indicators = [
  { label: 'GY GDP Growth', value: '+34.3%', type: 'estimate' },
  { label: 'TT GDP Growth', value: '+2.1%',  type: 'estimate' },
  { label: 'GY Inflation',  value: '2.2%',   type: 'estimate' },
  { label: 'TT Inflation',  value: '3.5%',   type: 'estimate' },
];
---

<header class="topbar">
  <div class="page-wrapper topbar-inner">
    <a href="/" class="brand" aria-label="Caribbean Macro Almanac home">
      <span class="brand-name">Caribbean Macro Almanac</span>
      <span class="brand-region mono">Caribbean · Economic Research</span>
    </a>

    <div class="ticker" aria-label="Key economic indicators" role="marquee">
      <ul class="ticker-list">
        {indicators.map(item => (
          <li class="ticker-item">
            <span class="ticker-label mono">{item.label}</span>
            <span class={`ticker-value mono ${item.type === 'estimate' ? 'estimate' : ''}`}>
              {item.value}
              {item.type === 'estimate' && <abbr title="Estimate">e</abbr>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<style>
  .topbar {
    background-color: var(--teal-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    height: var(--topbar-height);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--gap-md);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--paper);
    letter-spacing: -0.01em;
  }

  .brand-region {
    color: rgba(236, 238, 232, 0.5);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .ticker {
    overflow: hidden;
    flex: 1;
    max-width: 560px;
    mask-image: linear-gradient(to right, transparent, black 60px, black calc(100% - 60px), transparent);
  }

  .ticker-list {
    display: flex;
    gap: 32px;
    list-style: none;
    align-items: center;
    height: var(--topbar-height);
    justify-content: flex-end;
  }

  .ticker-item {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .ticker-label {
    color: rgba(236, 238, 232, 0.5);
    font-size: 10px;
    letter-spacing: 0.05em;
  }

  .ticker-value {
    color: var(--paper);
    font-size: 11px;
    font-weight: 500;
  }

  .ticker-value.estimate {
    color: rgba(188, 138, 46, 0.9);
  }

  .ticker-value abbr {
    text-decoration: none;
    font-size: 9px;
    opacity: 0.7;
    margin-left: 1px;
  }

  @media (max-width: 640px) {
    .ticker { display: none; }
    .brand-region { display: none; }
  }
</style>
