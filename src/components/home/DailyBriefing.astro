---
// Daily Briefing — two-column lead story + per-country key-indicators rail.
// Renders the active briefing; the homepage script repoints it (heading, dek,
// stats) when a Recent News item is clicked. IDs below are the update targets.

export interface BriefingStat {
  label: string;
  value: string;
  color: string;
}
export interface Briefing {
  key: string;
  tag: string;        // country display name, e.g. "Guyana" / "Regional"
  time: string;       // formatted date
  heading: string;
  dek: string;
  source: string;
  url: string;
  showRail: boolean;
  stats: BriefingStat[];
}

interface Props { briefing: Briefing }
const { briefing: b } = Astro.props;
---

<div class="briefing">
  <div class="briefing-meta pop-in pop-in-1">
    <span class="briefing-eyebrow mono">Daily briefing</span>
    <span class="briefing-chip mono" id="brief-tag">{b.tag}</span>
    <span class="briefing-updated mono">Updated <span id="brief-time">{b.time}</span></span>
  </div>

  <div class="briefing-grid">
    <div class="briefing-lead pop-in pop-in-2">
      <a class="briefing-headline-link" id="brief-link" href={b.url} target="_blank" rel="noopener noreferrer">
        <h2 class="briefing-headline" id="brief-heading">{b.heading}</h2>
      </a>
      <p class="briefing-dek" id="brief-dek">{b.dek}</p>
      <div class="briefing-source mono">
        <span class="briefing-rule"></span><span id="brief-source">{b.source}</span>
      </div>
    </div>

    <div class="briefing-rail pop-in pop-in-3" id="brief-rail" data-show={String(b.showRail)} hidden={!b.showRail}>
      <div class="rail-label mono"><span id="rail-tag">{b.tag}</span> · KEY INDICATORS</div>
      <div class="rail-stats" id="rail-stats">
        {b.stats.map(s => (
          <div class="rail-row">
            <span class="rail-stat-label">{s.label}</span>
            <span class="rail-stat-value" style={`color:${s.color}`}>{s.value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* Daily briefing — petrol-and-gold system (EDDESIGN.md). Hard edges, no shadows. */
  .briefing { padding: 52px 40px 48px; border-bottom: 1px solid var(--line); }

  .briefing-meta { display: flex; align-items: center; gap: 14px; margin-bottom: 26px; flex-wrap: wrap; }

  .briefing-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--teal);
  }

  .briefing-chip {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-mono);
    font-size: 11px; font-weight: 500; letter-spacing: 0.06em;
    color: var(--ink); background: var(--card-tint); border-left: 3px solid var(--teal);
    padding: 4px 10px; border-radius: 0;
  }

  .briefing-updated {
    font-family: var(--font-mono);
    font-size: 11px; color: var(--ink-faint); letter-spacing: 0.04em;
  }

  .briefing-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: 48px; align-items: start; }

  .briefing-headline-link { text-decoration: none; }

  .briefing-headline {
    font-family: var(--font-display);
    font-size: 40px; line-height: 1.04; font-weight: 800; letter-spacing: -0.02em;
    color: var(--ink); margin-bottom: 20px; text-wrap: balance;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    transition: color 0.12s ease;
  }
  .briefing-headline-link:hover .briefing-headline { color: var(--teal); }

  .briefing-dek {
    font-size: 16px; line-height: 1.6; color: var(--ink-soft); max-width: 60ch;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  .briefing-source {
    display: flex; align-items: center; gap: 10px; margin-top: 24px;
    font-family: var(--font-mono); font-size: 11px; color: var(--ink-faint); letter-spacing: 0.03em;
  }
  .briefing-rule { width: 22px; height: 1px; background: var(--ink-faint); }

  /* Key-indicators rail — tinted teal emphasis block */
  .briefing-rail { background: var(--card-tint); border-left: 3px solid var(--teal); padding: 22px 24px; }

  .rail-label {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-soft); margin-bottom: 18px;
  }

  .rail-stats { display: flex; flex-direction: column; gap: 0; }

  /* Rows are rebuilt via innerHTML by the homepage repoint script, so JS-injected
     elements don't carry Astro's scope attribute. Mark these :global (scoped under
     .rail-stats, which stays in the DOM) so the styles survive a re-render. */
  .rail-stats :global(.rail-row) {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    padding: 11px 0; border-bottom: 1px solid rgba(15, 35, 30, 0.10);
  }
  .rail-stats :global(.rail-row:last-child) { border-bottom: none; }

  .rail-stats :global(.rail-stat-label) { font-size: 13px; color: var(--ink-soft); }

  .rail-stats :global(.rail-stat-value) {
    font-family: var(--font-display);
    font-size: 21px; font-weight: 700; line-height: 1;
  }

  @media (max-width: 820px) {
    .briefing { padding: 36px 24px 32px; }
    .briefing-grid { grid-template-columns: 1fr; gap: 28px; }
    .briefing-headline { font-size: 30px; }
  }
</style>
