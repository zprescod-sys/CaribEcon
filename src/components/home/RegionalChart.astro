---
// "The Guyana divergence" — regional real GDP indexed to a base year, with Guyana
// as the breakout line against flat regional peers. Data is read from the hub at
// build time (never hardcoded) and serialised into a hidden element the D3 script reads.

import { getSeries, getCountries } from '../../lib/dataHub';

interface Props {
  baseYear?: number;
}
const { baseYear = 2018 } = Astro.props;

// Guyana highlighted; flat peers that have history back to the base year render muted.
const DISPLAY = [
  { code: 'GY', color: '#0c7a74', highlight: true },
  { code: 'JM', color: '#c4bfb1', highlight: false },
  { code: 'BB', color: '#cfcabd', highlight: false },
  { code: 'BS', color: '#d6d1c4', highlight: false },
];

const names = Object.fromEntries(getCountries().map(c => [c.code, c.name]));

const rawSeries = DISPLAY
  .map(d => {
    const s = getSeries(d.code, 'real_gdp');
    if (!s) return null;
    const values = s.series
      .filter(p => p.value !== null && p.year >= baseYear)
      .map(p => ({ year: p.year, value: p.value as number }));
    // Only include a country if it actually has the base year to index against.
    return values.some(v => v.year === baseYear)
      ? { country: d.code, name: names[d.code] ?? d.code, color: d.color, highlight: d.highlight, values }
      : null;
  })
  .filter((r): r is NonNullable<typeof r> => r !== null);

const chartJSON = JSON.stringify({ series: rawSeries, baseYear });
---

<section class="regional-chart-section">
  <div class="chart-header">
    <div>
      <h3 class="chart-title">The Guyana divergence</h3>
      <p class="chart-subtitle">Regional real GDP indexed to {baseYear} — the resource boom in one line.</p>
    </div>
    <div class="chart-base mono">{baseYear} = 100</div>
  </div>

  <div class="chart-container" id="regional-chart" role="img" aria-label="Regional real GDP indexed chart, Guyana diverging">
    <div class="chart-loading mono">Loading chart…</div>
  </div>

  <div id="regional-data" data-chart={chartJSON} hidden></div>
</section>

<script>
  import * as d3 from 'd3';

  type Point  = { year: number; value: number };
  type Series = { country: string; name: string; color: string; highlight: boolean; values: Point[] };

  const dataEl = document.getElementById('regional-data') as HTMLElement;
  const { series: RAW_DATA, baseYear: BASE_YEAR } =
    JSON.parse(dataEl.dataset.chart ?? '{"series":[],"baseYear":0}') as
    { series: Series[]; baseYear: number };

  // Index each series to BASE_YEAR = 100.
  const data = RAW_DATA.map(s => {
    const base = s.values.find(v => v.year === BASE_YEAR)?.value ?? s.values[0]?.value ?? 1;
    return { ...s, indexed: s.values.map(v => ({ year: v.year, value: (v.value / base) * 100 })) };
  });

  const container = document.getElementById('regional-chart');
  if (!container) throw new Error('Chart container not found');

  const margin = { top: 22, right: 64, bottom: 34, left: 40 };
  const width  = container.clientWidth - margin.left - margin.right;
  const height = Math.min(300, Math.max(220, container.clientWidth * 0.34)) - margin.top - margin.bottom;

  container.innerHTML = '';

  const svg = d3.select(container)
    .append('svg')
    .attr('width',  width  + margin.left + margin.right)
    .attr('height', height + margin.top  + margin.bottom)
    .append('g')
    .attr('transform', `translate(${margin.left},${margin.top})`);

  const allYears  = [...new Set(data.flatMap(s => s.indexed.map(d => d.year)))].sort();
  const allValues = data.flatMap(s => s.indexed.map(d => d.value));

  const xScale = d3.scalePoint<number>().domain(allYears).range([0, width]).padding(0.04);
  const yScale = d3.scaleLinear().domain([0, Math.max(...allValues) * 1.08]).range([height, 0]).nice();

  // Horizontal gridlines + value labels
  svg.append('g')
    .call(d3.axisLeft(yScale).ticks(5).tickSize(-width).tickFormat(d => `${d}`))
    .call(g => {
      g.select('.domain').remove();
      g.selectAll('.tick line').attr('stroke', '#ebe7dc');
      g.selectAll('text')
        .attr('font-family', 'IBM Plex Mono, monospace')
        .attr('font-size', '10').attr('fill', '#b3ad9e').attr('x', -8);
    });

  // X axis (years)
  svg.append('g')
    .attr('transform', `translate(0,${height})`)
    .call(d3.axisBottom(xScale).tickFormat(d => String(d)))
    .call(g => {
      g.select('.domain').remove();
      g.selectAll('.tick line').remove();
      g.selectAll('text')
        .attr('font-family', 'IBM Plex Mono, monospace')
        .attr('font-size', '10').attr('fill', '#b3ad9e');
    });

  const line = d3.line<{ year: number; value: number }>()
    .x(d => xScale(d.year)!)
    .y(d => yScale(d.value))
    .curve(d3.curveMonotoneX);

  const area = d3.area<{ year: number; value: number }>()
    .x(d => xScale(d.year)!)
    .y0(height)
    .y1(d => yScale(d.value))
    .curve(d3.curveMonotoneX);

  // Draw muted peers first, highlight (Guyana) last so it sits on top.
  [...data].sort((a, b) => Number(a.highlight) - Number(b.highlight)).forEach(series => {
    if (series.highlight) {
      svg.append('path').datum(series.indexed)
        .attr('fill', series.color).attr('fill-opacity', 0.07).attr('d', area);
    }
    svg.append('path').datum(series.indexed)
      .attr('fill', 'none')
      .attr('stroke', series.color)
      .attr('stroke-width', series.highlight ? 2.5 : 1.5)
      .attr('d', line);

    const last = series.indexed[series.indexed.length - 1];
    if (series.highlight) {
      svg.append('circle')
        .attr('cx', xScale(last.year)!).attr('cy', yScale(last.value)).attr('r', 3.5)
        .attr('fill', series.color);
      svg.append('text')
        .attr('x', xScale(last.year)! - 12).attr('y', yScale(last.value) - 8)
        .attr('text-anchor', 'end')
        .attr('font-family', 'Source Serif 4, serif')
        .attr('font-size', '13').attr('font-weight', '600').attr('fill', series.color)
        .text(series.name);
    } else {
      svg.append('text')
        .attr('x', xScale(last.year)! + 8).attr('y', yScale(last.value) + 3)
        .attr('font-family', 'IBM Plex Mono, monospace')
        .attr('font-size', '10').attr('fill', '#a8a496')
        .text(series.country);
    }
  });
</script>

<style>
  .regional-chart-section { padding: 4px 0; }

  .chart-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-md);
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .chart-title {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 21px;
    font-weight: 600;
    color: #16170f;
    letter-spacing: -0.01em;
  }

  .chart-subtitle {
    font-size: 13px;
    color: #6f6e64;
    margin-top: 4px;
  }

  .chart-base {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #a8a496;
    letter-spacing: 0.04em;
  }

  .chart-container { width: 100%; min-height: 200px; }
  .chart-container svg { display: block; width: 100%; }

  .chart-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    color: #a8a496;
    font-size: 11px;
  }
</style>
