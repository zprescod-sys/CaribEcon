---
// Year-in-focus panel — appears when user clicks a year on the line chart.
// This Astro component renders the empty panel shell; the chart script populates it.
---

<aside
  class="yif-panel card"
  id="year-in-focus"
  aria-label="Year in focus"
  aria-live="polite"
  hidden
>
  <div class="yif-header">
    <span class="eyebrow">Year in Focus</span>
    <button class="yif-close mono" id="yif-close" aria-label="Close year-in-focus panel">✕</button>
  </div>

  <div class="yif-year" id="yif-year"></div>
  <p class="yif-event" id="yif-event"></p>

  <div class="yif-metrics mono" id="yif-metrics"></div>

  <div class="yif-trust mono" id="yif-trust"></div>

  <div class="yif-headlines" id="yif-headlines"></div>
</aside>

<script>
  // Wire the close button
  const panel   = document.getElementById('year-in-focus') as HTMLElement | null;
  const closeBtn = document.getElementById('yif-close');

  closeBtn?.addEventListener('click', () => {
    if (panel) panel.hidden = true;
  });
</script>

<style>
  .yif-panel {
    padding: 20px;
    background-color: var(--card-tint);
    border-left: var(--border-left-gold);
    animation: fadeUp 0.2s ease forwards;
  }

  .yif-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .yif-close {
    font-size: 11px;
    padding: 2px 6px;
    border-color: transparent;
    color: var(--ink-faint);
  }

  .yif-close:hover {
    background: none;
    color: var(--ink);
  }

  .yif-year {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 800;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 8px;
  }

  .yif-event {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 48ch;
    margin-bottom: 16px;
  }

  .yif-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 14px;
  }

  :global(.yif-metric) {
    border: 1px solid var(--line);
    background: var(--card);
    padding: 9px 10px;
  }

  :global(.yif-metric-label) {
    display: block;
    color: var(--ink-faint);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 3px;
  }

  :global(.yif-metric-value) { color: var(--ink); font-size: 12px; }

  .yif-trust {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 14px;
    font-size: 9px;
  }

  :global(.yif-trust-badge) {
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink-soft);
    padding: 4px 6px;
  }

  :global(.yif-trust-badge a) { color: inherit; text-decoration: underline; }

  .yif-headlines {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.yif-headline-item) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    color: var(--ink);
    border-top: 1px solid var(--line);
    padding: 10px 8px 2px;
    line-height: 1.4;
    cursor: pointer;
    transition: background 0.12s ease, box-shadow 0.12s ease;
  }

  :global(.yif-headline-item:hover) {
    background: var(--paper-warm);
  }

  :global(.yif-headline-item:focus-visible) {
    outline: none;
    box-shadow: inset 0 0 0 1.5px var(--gold);
  }

  /* The country the panel is currently pinned to */
  :global(.yif-headline-item.is-focused) {
    background: var(--paper-warm);
  }

  :global(.yif-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 4px;
  }

  :global(.yif-country) {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--ink-faint);
    display: block;
    margin-bottom: 2px;
    text-transform: uppercase;
  }

  :global(.yif-val) {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  :global(.yif-unit) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--ink-faint);
  }

  :global(.yif-type) {
    font-family: var(--font-mono);
    font-size: 9px;
    color: #BC8A2E;
    margin-left: 4px;
    vertical-align: super;
  }

  @media (max-width: 560px) {
    .yif-metrics { grid-template-columns: 1fr; }
  }
</style>
