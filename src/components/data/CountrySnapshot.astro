---
// Reusable per-country snapshot: country header + a grid of hard-edged metric
// cards (title, topic icon, value, colored trend). Rendered once per country by
// the carousel — data is pre-computed in data.astro from the data hub.

export interface SnapshotRow {
  slug: string;             // indicator slug, e.g. "gdp_growth"
  label: string;            // "Real GDP Growth"
  value: string;            // "43.8%" or "1,834"
  unitSuffix: string;       // "" for %, "USD mn" for FDI
  year: number;
  delta: string | null;     // "+0.3pp" / "−112"
  deltaDir: 'pos' | 'neg' | null;
  vsYear: number | null;
  flag: 'estimate' | 'projection' | null;
}

export interface CountrySnapshotData {
  code: string;
  name: string;
  flag?: string;
  lead: SnapshotRow;
  rows: SnapshotRow[];
  sources: string;          // "IMF · UNCTAD"
}

interface Props {
  snapshot: CountrySnapshotData;
}

const { snapshot } = Astro.props;

// One flat list of metrics; the first (lead) gets the emphasis treatment.
const metrics = [snapshot.lead, ...snapshot.rows];

// Arrow glyph for a delta direction
const arrow = (dir: 'pos' | 'neg' | null) => dir === 'pos' ? '▲' : dir === 'neg' ? '▼' : '–';

// Lucide-style topic icon picked from the indicator label. Returns the inner
// SVG markup (stroked, 24-viewBox) so it inherits currentColor.
function iconFor(label: string): string {
  const l = label.toLowerCase();
  if (l.includes('gdp') || l.includes('growth'))
    return '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>';
  if (l.includes('inflation') || l.includes('cpi') || l.includes('price'))
    return '<line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>';
  if (l.includes('debt') || l.includes('fiscal') || l.includes('revenue'))
    return '<line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/>';
  if (l.includes('fdi') || l.includes('investment') || l.includes('trade'))
    return '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>';
  if (l.includes('unemploy') || l.includes('labour') || l.includes('labor') || l.includes('population'))
    return '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>';
  return '<line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/>';
}
---

<article class="country-snapshot" aria-label={`${snapshot.name} key statistics`} data-country={snapshot.code}>
  <header class="snap-head">
    {snapshot.flag && <span class="snap-flag" aria-hidden="true">{snapshot.flag}</span>}
    <h2 class="snap-name">{snapshot.name}</h2>
  </header>

  <div class="metric-grid">
    {metrics.map((m, i) => (
      <div class={`metric-card ${i === 0 ? 'lead' : ''}`} data-slug={m.slug} role="button" tabindex="0" aria-label={`View ${m.label} in chart explorer`}>
        <div class="metric-head">
          <span class="metric-title mono">{m.label}</span>
          <svg class="metric-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
               aria-hidden="true" set:html={iconFor(m.label)} />
        </div>

        <div class="metric-value">
          {m.value}{m.unitSuffix && <span class="metric-unit mono"> {m.unitSuffix}</span>}
        </div>

        <div class="metric-foot">
          {m.delta ? (
            <span class={`metric-trend mono ${m.deltaDir}`}>
              <span class="metric-arrow">{arrow(m.deltaDir)}</span> {m.delta}
              {m.vsYear && <span class="metric-vs">vs {m.vsYear}</span>}
            </span>
          ) : (
            <span class="metric-trend mono none">{m.year}</span>
          )}
          {m.flag && <span class="metric-type-flag mono">{m.flag}</span>}
        </div>
      </div>
    ))}
  </div>

  <footer class="snap-source mono">Source: {snapshot.sources}</footer>
</article>

<script>
  // Clicking a metric card sets both the country and indicator in the chart explorer.
  document.querySelectorAll<HTMLElement>('.metric-card[data-slug]').forEach(card => {
    const activate = () => {
      const article = card.closest<HTMLElement>('.country-snapshot');
      const country = article?.dataset.country;
      const slug    = card.dataset.slug;
      if (!country || !slug) return;
      document.dispatchEvent(new CustomEvent('country-select',    { detail: { country } }));
      document.dispatchEvent(new CustomEvent('indicator-select',  { detail: { indicator: slug } }));
      document.getElementById('chart-explorer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    card.addEventListener('click', activate);
    card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); } });
  });
</script>

<style>
  .country-snapshot { padding: 20px 0 8px; }

  /* ── Country header ──────────────────────────────────────── */
  .snap-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .snap-flag { font-size: 20px; line-height: 1; }
  .snap-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  /* ── Metric card grid ────────────────────────────────────── */
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    background-color: var(--card);
    border: 1px solid var(--line);
    /* Gold signal strip along the top of every card (consistent across the grid) */
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    cursor: pointer;
    transition: transform 150ms ease, border-color 150ms ease;
  }
  .metric-card:hover {
    transform: translateY(-3px);
    border-color: var(--teal);
  }
  .metric-card:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .metric-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .metric-title {
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    line-height: 1.3;
  }
  .metric-icon { width: 16px; height: 16px; color: var(--ink-faint); flex-shrink: 0; }

  .metric-value {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .metric-card.lead .metric-value { font-size: 38px; }

  .metric-unit {
    font-size: 10px;
    color: var(--ink-faint);
    font-weight: 400;
  }

  .metric-foot {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: auto;
  }
  .metric-trend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .metric-arrow { font-size: 9px; }
  .metric-trend.pos { color: var(--pos); }
  .metric-trend.neg { color: var(--neg); }
  .metric-trend.none { color: var(--ink-faint); font-weight: 400; }
  .metric-vs { color: var(--ink-faint); font-weight: 400; margin-left: 2px; }

  /* Quiet data flag — reads as metadata, not a control */
  .metric-type-flag {
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: var(--ink-faint);
  }

  .snap-source {
    margin-top: 16px;
    font-size: 10px;
    color: var(--ink-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .metric-card { transition: none; }
    .metric-card:hover { transform: none; }
  }

  @media (max-width: 700px) {
    .metric-card.lead .metric-value { font-size: 32px; }
  }
</style>
