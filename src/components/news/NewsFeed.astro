---
// News feed — macro-category filter bar + keyword/country search + article list.
import type { NewsData } from '../../lib/types';
import { getCountries, classifyNews, NEWS_GROUPS } from '../../lib/dataHub';

interface Props {
  news: NewsData;
}

const { news } = Astro.props;
const countries = getCountries();

// Code -> name map for search matching
const countryNameMap: Record<string, string> = Object.fromEntries(
  countries.map(c => [c.code, c.name])
);

function countryLabels(country: string | string[]) {
  return (Array.isArray(country) ? country : [country]).map(code => (
    code === 'ALL' ? 'Caribbean regional' : countryNameMap[code] ?? code
  ));
}

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

// Classify each item once, on the server, into a macro category (card chip) + coarse
// group (filter bar). Then order the group tabs "All" first, then only the groups that
// actually have stories in this set — no empty tabs.
const items = news.map(item => ({ item, ...classifyNews(item.title, item.tags) }));
const presentGroups = NEWS_GROUPS.filter(g => items.some(i => i.group === g));
const groupTabs = ['All', ...presentGroups];
---

<div class="news-section">
  <!-- Category filter tabs -->
  <div class="group-tabs mono" role="tablist" aria-label="Filter news by macro category">
    {groupTabs.map((g, i) => (
      <button
        type="button"
        class:list={['group-tab', { active: i === 0 }]}
        data-group={g === 'All' ? 'all' : g}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
      >{g}</button>
    ))}
  </div>

  <!-- Search bar -->
  <div class="filter-bar">
    <form class="search-wrap" id="news-search-form" role="search">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"/>
        <line x1="10.5" y1="10.5" x2="15" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
      </svg>
      <input
        type="search"
        id="news-search"
        class="news-search mono"
        placeholder="Search by keyword or country..."
        autocomplete="off"
        aria-label="Search news by keyword or country"
      />
      <button class="search-clear" id="news-clear" type="button" aria-label="Clear search" hidden>x</button>
      <button class="search-submit mono" type="submit">Search</button>
    </form>
    <span class="filter-hint mono" id="filter-hint"></span>
  </div>

  <!-- Feed -->
  <div id="news-feed" class="news-list" aria-live="polite" aria-label="News articles">
    {items.map(({ item, category, group }) => {
      const country = Array.isArray(item.country) ? item.country.join(',') : item.country;
      const searchText = [
        item.title,
        item.source,
        item.date,
        country,
        category,
        ...countryLabels(item.country),
        ...(item.tags ?? []),
      ].join(' ');
      return (
        <article class="news-item" data-country={country} data-group={group} data-search={searchText}>
          <div class="news-tags">
            <span class="news-cat mono">{category}</span>
            {(Array.isArray(item.country) ? item.country : [item.country])
              .filter(c => c !== 'ALL')
              .map(c => <span class="badge">{c}</span>)
            }
          </div>
          <a class="news-title" href={item.url} target="_blank" rel="noopener noreferrer">
            {item.title}
          </a>
          <div class="news-meta">
            <span class="mono news-source">{item.source}</span>
            <time class="mono" datetime={item.date}>{formatDate(item.date)}</time>
          </div>
        </article>
      );
    })}
  </div>

  <div id="news-empty" class="news-empty mono" hidden>
    No relevant economic headlines available for this filter at the moment.
  </div>

  <!-- Pagination -->
  <nav class="pager mono" id="news-pager" aria-label="News pagination"></nav>
</div>

<script>
  const PAGE_SIZE = 15;

  const searchForm  = document.getElementById('news-search-form') as HTMLFormElement | null;
  const searchInput = document.getElementById('news-search') as HTMLInputElement | null;
  const clearBtn    = document.getElementById('news-clear') as HTMLButtonElement | null;
  const hint        = document.getElementById('filter-hint') as HTMLElement | null;
  const feed        = document.getElementById('news-feed') as HTMLElement | null;
  const emptyEl     = document.getElementById('news-empty') as HTMLElement | null;
  const pager       = document.getElementById('news-pager') as HTMLElement | null;
  const groupTabs   = Array.from(document.querySelectorAll<HTMLButtonElement>('.group-tab'));
  const items       = Array.from(document.querySelectorAll<HTMLElement>('.news-item'));

  let filtered: HTMLElement[] = items;   // items matching the current group + search
  let activeGroup = 'all';               // macro-category tab; 'all' shows everything
  let query = '';
  let page = 1;

  function normalize(value: string) {
    return value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/\bt\s*(?:&|and)\s*t\b/g, 'tt trinidad tobago')
      .replace(/&/g, ' and ')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();
  }

  // Recompute the matching set from the active group + search query, reset to page 1.
  function applyFilter() {
    const q = normalize(query);
    const terms = q ? q.split(/\s+/).filter(term => term !== 'and') : [];
    filtered = items.filter(item => {
      if (activeGroup !== 'all' && item.dataset.group !== activeGroup) return false;
      if (terms.length === 0) return true;
      const haystack = normalize(item.dataset.search ?? '');
      return terms.every(term => haystack.includes(term));
    });
    page = 1;
    if (clearBtn) clearBtn.hidden = !q;
    render();
  }

  // Show only the current page's slice of the filtered set; rebuild the pager.
  function render() {
    const total = filtered.length;
    const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (page > pages) page = pages;
    const start = (page - 1) * PAGE_SIZE;
    const shown = new Set(filtered.slice(start, start + PAGE_SIZE));

    items.forEach(item => { item.hidden = !shown.has(item); });
    if (emptyEl) emptyEl.hidden = total > 0;
    if (hint) {
      hint.textContent = total
        ? `${total} article${total === 1 ? '' : 's'}${pages > 1 ? ` \u00b7 page ${page} of ${pages}` : ''}`
        : '';
    }
    renderPager(pages);
  }

  // Build the page numbers to show: always first + last, plus a window around the
  // current page, with gaps ("\u2026") collapsing the rest.
  function pageWindow(pages: number, current: number): (number | 'gap')[] {
    const keep = new Set<number>([1, pages, current, current - 1, current + 1]);
    const nums = [...keep].filter(p => p >= 1 && p <= pages).sort((a, b) => a - b);
    const out: (number | 'gap')[] = [];
    let prev = 0;
    for (const p of nums) {
      if (p - prev > 1) out.push('gap');
      out.push(p);
      prev = p;
    }
    return out;
  }

  function renderPager(pages: number) {
    if (!pager) return;
    pager.innerHTML = '';
    if (pages <= 1) return;

    const btn = (label: string, opts: { target?: number; active?: boolean; disabled?: boolean; gap?: boolean }) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'page-btn' + (opts.active ? ' active' : '') + (opts.gap ? ' gap' : '');
      b.textContent = label;
      if (opts.gap || opts.disabled) {
        b.disabled = true;
      } else {
        b.addEventListener('click', () => {
          page = opts.target!;
          render();
          feed?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
      pager.appendChild(b);
    };

    btn('\u2039', { target: page - 1, disabled: page === 1 });
    for (const p of pageWindow(pages, page)) {
      if (p === 'gap') btn('\u2026', { gap: true });
      else btn(String(p), { target: p, active: p === page });
    }
    btn('\u203a', { target: page + 1, disabled: page === pages });
  }

  searchInput?.addEventListener('input', () => { query = searchInput.value; applyFilter(); });
  searchForm?.addEventListener('submit', event => {
    event.preventDefault();
    query = searchInput?.value ?? '';
    applyFilter();
  });
  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    query = '';
    applyFilter();
    searchInput?.focus();
  });

  // Category tabs — switch the active group, keep any live search query applied.
  groupTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      activeGroup = tab.dataset.group ?? 'all';
      groupTabs.forEach(t => {
        const on = t === tab;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      applyFilter();
    });
  });

  render();   // initial paint
</script>

<style>
  .news-section { margin-top: var(--gap-md); }

  /* Category filter tabs */
  .group-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .group-tab {
    border: var(--border);
    border-radius: 0;
    background: var(--card);
    color: var(--ink-soft);
    padding: 7px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    cursor: pointer;
    line-height: 1;
  }

  .group-tab:hover:not(.active) { border-color: var(--teal); color: var(--ink); }

  .group-tab.active {
    background: var(--teal);
    color: #fff;
    border-color: var(--teal);
    cursor: default;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 20px;
    border-bottom: var(--border);
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    color: var(--ink-faint);
    pointer-events: none;
  }

  .news-search {
    appearance: none;
    border: var(--border);
    border-radius: 0;
    background: var(--card);
    padding: 8px 32px 8px 32px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--ink);
    min-width: 240px;
    outline: none;
  }

  .news-search:focus { border-color: var(--teal); }

  .news-search::-webkit-search-cancel-button { display: none; }

  .search-clear {
    position: absolute;
    right: 8px;
    background: none;
    border: none;
    padding: 0;
    font-size: 10px;
    color: var(--ink-faint);
    cursor: pointer;
    line-height: 1;
  }

  .search-clear:hover { color: var(--ink); }

  .search-submit {
    border: var(--border);
    border-radius: 0;
    background: var(--teal);
    color: #fff;
    padding: 9px 14px;
    font-size: 11px;
    font-family: var(--font-mono);
    cursor: pointer;
    letter-spacing: 0.04em;
  }

  .search-submit:hover,
  .search-submit:focus-visible {
    background: var(--ink);
  }

  .filter-hint {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .news-item {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .news-item[hidden] { display: none; }

  .news-tags {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .news-cat {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
    background: color-mix(in srgb, var(--teal) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--teal) 28%, transparent);
    padding: 3px 7px;
    line-height: 1;
  }

  .news-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
    max-width: 72ch;
    text-decoration: none;
  }

  .news-title:hover { text-decoration: underline; color: var(--teal); }

  .news-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .news-source { color: var(--ink-soft); }

  .news-empty { padding: 40px 0; color: var(--ink-faint); font-size: 12px; }

  /* Pagination */
  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
  }

  .pager:empty { display: none; }

  .page-btn {
    min-width: 32px;
    border: var(--border);
    background: var(--card);
    color: var(--ink-soft);
    padding: 7px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    cursor: pointer;
  }

  .page-btn:hover:not(:disabled):not(.active) {
    border-color: var(--teal);
    color: var(--ink);
  }

  .page-btn.active {
    background: var(--teal);
    color: #fff;
    border-color: var(--teal);
    cursor: default;
  }

  .page-btn:disabled { cursor: default; }

  .page-btn.gap {
    border: none;
    background: none;
    color: var(--ink-faint);
    min-width: 0;
    padding: 7px 2px;
  }
</style>
