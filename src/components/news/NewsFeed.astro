---
// News feed — country search bar + article list.
import type { NewsData } from '../../lib/types';
import { getCountries } from '../../lib/dataHub';

interface Props {
  news: NewsData;
}

const { news } = Astro.props;
const countries = getCountries();

// Code → name map for search matching
const countryNameMap: Record<string, string> = Object.fromEntries(
  countries.map(c => [c.code, c.name.toLowerCase()])
);
const namesMapJSON = JSON.stringify(countryNameMap);

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<div class="news-section">
  <!-- Search bar -->
  <div class="filter-bar">
    <div class="search-wrap">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"/>
        <line x1="10.5" y1="10.5" x2="15" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
      </svg>
      <input
        type="search"
        id="news-search"
        class="news-search mono"
        placeholder="Filter by country…"
        autocomplete="off"
        aria-label="Filter news by country"
      />
      <button class="search-clear" id="news-clear" type="button" aria-label="Clear filter" hidden>✕</button>
    </div>
    <span class="filter-hint mono" id="filter-hint"></span>
  </div>

  <!-- Feed -->
  <div id="news-feed" class="news-list" aria-live="polite" aria-label="News articles">
    {news.map(item => {
      const country = Array.isArray(item.country) ? item.country.join(',') : item.country;
      return (
        <article class="news-item" data-country={country}>
          <a class="news-title" href={item.url} target="_blank" rel="noopener noreferrer">
            {item.title}
          </a>
          <div class="news-meta">
            <span class="mono news-source">{item.source}</span>
            <time class="mono" datetime={item.date}>{formatDate(item.date)}</time>
            {(Array.isArray(item.country) ? item.country : [item.country])
              .filter(c => c !== 'ALL')
              .map(c => <span class="badge">{c}</span>)
            }
          </div>
        </article>
      );
    })}
  </div>

  <div id="news-empty" class="news-empty mono" hidden>
    No articles match that country.
  </div>
</div>

<div id="news-country-map" data-map={namesMapJSON} hidden></div>

<script>
  const searchInput = document.getElementById('news-search') as HTMLInputElement | null;
  const clearBtn    = document.getElementById('news-clear') as HTMLButtonElement | null;
  const hint        = document.getElementById('filter-hint') as HTMLElement | null;
  const items       = document.querySelectorAll<HTMLElement>('.news-item');
  const emptyEl     = document.getElementById('news-empty') as HTMLElement | null;
  const mapEl       = document.getElementById('news-country-map') as HTMLElement | null;

  const countryNames: Record<string, string> = JSON.parse(mapEl?.dataset.map ?? '{}');

  function filterNews(query: string) {
    const q = query.trim().toLowerCase();
    let visible = 0;

    items.forEach(item => {
      const codes = (item.dataset.country ?? '').split(',');
      let match = false;
      if (!q || codes.includes('ALL')) {
        match = true;
      } else {
        match = codes.some(code =>
          code.toLowerCase().includes(q) ||
          (countryNames[code] ?? '').includes(q)
        );
      }
      item.hidden = !match;
      if (match) visible++;
    });

    if (emptyEl) emptyEl.hidden = visible > 0;
    if (clearBtn) clearBtn.hidden = !q;
    if (hint) hint.textContent = q && visible > 0 ? `${visible} article${visible === 1 ? '' : 's'}` : '';
  }

  searchInput?.addEventListener('input', () => filterNews(searchInput.value));
  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    filterNews('');
    searchInput?.focus();
  });
</script>

<style>
  .news-section { margin-top: var(--gap-md); }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 20px;
    border-bottom: var(--border);
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    color: var(--ink-faint);
    pointer-events: none;
  }

  .news-search {
    appearance: none;
    border: var(--border);
    border-radius: 0;
    background: var(--card);
    padding: 8px 32px 8px 32px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--ink);
    min-width: 240px;
    outline: none;
  }

  .news-search:focus { border-color: var(--teal); }

  .news-search::-webkit-search-cancel-button { display: none; }

  .search-clear {
    position: absolute;
    right: 8px;
    background: none;
    border: none;
    padding: 0;
    font-size: 10px;
    color: var(--ink-faint);
    cursor: pointer;
    line-height: 1;
  }

  .search-clear:hover { color: var(--ink); }

  .filter-hint {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .news-item {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .news-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
    max-width: 72ch;
    text-decoration: none;
  }

  .news-title:hover { text-decoration: underline; color: var(--teal); }

  .news-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .news-source { color: var(--ink-soft); }

  .news-empty { padding: 40px 0; color: var(--ink-faint); font-size: 12px; }
</style>
