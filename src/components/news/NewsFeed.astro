---
// News feed — macro-category filter bar + keyword/country search + article list.
// Only the first NEWS_PAGE_SIZE items (the `news` prop) render as static HTML, for a
// fast first paint that works even before/without JS. Paging past 1, switching a
// category tab, or searching all read from a background-fetched /news-index.json
// covering the FULL archive instead (see the client-side script block below and
// src/pages/news-index.json.ts) — search/pagination never miss older stories, they
// just don't require the whole archive to be rendered up front.
import type { NewsData } from '../../lib/types';
import { NEWS_GROUPS } from '../../lib/dataHub';
import { resolveCategoryGroup } from '../../lib/newsSearch';

interface Props {
  news: NewsData;     // first NEWS_PAGE_SIZE items — what actually gets rendered here
  allNews: NewsData;  // full archive — only used to compute which tabs to show + the total count
}

const { news, allNews } = Astro.props;

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const items = news.map(item => ({ item, ...resolveCategoryGroup(item) }));

// Tabs are computed from the FULL archive, not just the rendered slice — otherwise a
// group with no stories in the newest NEWS_PAGE_SIZE items (e.g. Finance, as of this
// writing) would silently vanish from the tab bar even though it has real stories
// further back in the archive.
const allGroups = allNews.map(item => resolveCategoryGroup(item).group);
const presentGroups = NEWS_GROUPS.filter(g => allGroups.includes(g));
const groupTabs = ['All', ...presentGroups];
const totalCount = allNews.length;
---

<div class="news-section">
  <!-- Category filter tabs -->
  <div class="group-tabs mono" role="tablist" aria-label="Filter news by macro category">
    {groupTabs.map((g, i) => (
      <button
        type="button"
        class:list={['group-tab', { active: i === 0 }]}
        data-group={g === 'All' ? 'all' : g}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
      >{g}</button>
    ))}
  </div>

  <!-- Search bar -->
  <div class="filter-bar">
    <form class="search-wrap" id="news-search-form" role="search">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"/>
        <line x1="10.5" y1="10.5" x2="15" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
      </svg>
      <input
        type="search"
        id="news-search"
        class="news-search mono"
        placeholder="Search by keyword or country..."
        autocomplete="off"
        aria-label="Search news by keyword or country"
      />
      <button class="search-clear" id="news-clear" type="button" aria-label="Clear search" hidden>x</button>
      <button class="search-submit mono" type="submit">Search</button>
    </form>
    <span class="filter-hint mono" id="filter-hint">{totalCount} article{totalCount === 1 ? '' : 's'}</span>
  </div>

  <!-- Feed: the first NEWS_PAGE_SIZE items, real static HTML. Everything past this
       (page 2+, a non-"All" tab, or any search) gets rendered by the client script
       from the fetched index instead, replacing these nodes entirely. -->
  <div id="news-feed" class="news-list" aria-live="polite" aria-label="News articles" data-total={totalCount}>
    {items.map(({ item, category }) => (
      <article class="news-item">
        <div class="news-tags">
          <span class="news-cat mono">{category}</span>
          {(Array.isArray(item.country) ? item.country : [item.country])
            .filter(c => c !== 'ALL')
            .map(c => <span class="badge">{c}</span>)
          }
        </div>
        <a class="news-title" href={item.url} target="_blank" rel="noopener noreferrer">
          {item.title}
        </a>
        <div class="news-meta">
          <span class="mono news-source">{item.source}</span>
          <time class="mono" datetime={item.date}>{formatDate(item.date)}</time>
        </div>
      </article>
    ))}
  </div>

  <div id="news-empty" class="news-empty mono" hidden>
    No relevant economic headlines available for this filter at the moment.
  </div>

  <!-- Pagination -->
  <nav class="pager mono" id="news-pager" aria-label="News pagination"></nav>
</div>

<script>
  import { NEWS_PAGE_SIZE, normalize, splitTerms, matchesTerms } from '../../lib/newsSearch';
  import type { NewsIndexItem } from '../../lib/newsSearch';

  const searchForm  = document.getElementById('news-search-form') as HTMLFormElement | null;
  const searchInput = document.getElementById('news-search') as HTMLInputElement | null;
  const clearBtn    = document.getElementById('news-clear') as HTMLButtonElement | null;
  const hint        = document.getElementById('filter-hint') as HTMLElement | null;
  const feed        = document.getElementById('news-feed') as HTMLElement | null;
  const emptyEl     = document.getElementById('news-empty') as HTMLElement | null;
  const pager       = document.getElementById('news-pager') as HTMLElement | null;
  const groupTabEls = Array.from(document.querySelectorAll<HTMLButtonElement>('.group-tab'));
  const totalInitial = Number(feed?.dataset.total ?? '0');

  let activeGroup = 'all';       // macro-category tab; 'all' shows everything
  let query = '';
  let page = 1;
  let interacted = false;        // becomes true on the user's first search/tab/page action
  let currentFiltered: NewsIndexItem[] = [];

  // Fetches the full archive once, kicked off immediately so it's normally already
  // resolved by the time anyone actually interacts. Safe to call repeatedly — same
  // promise every time, never re-fetches.
  let indexPromise: Promise<NewsIndexItem[]> | null = null;
  function loadIndex(): Promise<NewsIndexItem[]> {
    if (!indexPromise) indexPromise = fetch('/news-index.json').then(r => r.json());
    return indexPromise;
  }
  loadIndex();

  function formatDate(d: string) {
    return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  // Builds a card via real DOM APIs — never innerHTML. Headline/source text comes
  // from external RSS feeds, so it must never be treated as trusted HTML.
  function renderArticleEl(item: NewsIndexItem): HTMLElement {
    const article = document.createElement('article');
    article.className = 'news-item';

    const tags = document.createElement('div');
    tags.className = 'news-tags';
    const cat = document.createElement('span');
    cat.className = 'news-cat mono';
    cat.textContent = item.category ?? '';
    tags.appendChild(cat);
    const codes = Array.isArray(item.country) ? item.country : [item.country];
    for (const code of codes) {
      if (code === 'ALL') continue;
      const badge = document.createElement('span');
      badge.className = 'badge';
      badge.textContent = code;
      tags.appendChild(badge);
    }
    article.appendChild(tags);

    const titleLink = document.createElement('a');
    titleLink.className = 'news-title';
    titleLink.href = item.url;
    titleLink.target = '_blank';
    titleLink.rel = 'noopener noreferrer';
    titleLink.textContent = item.title;
    article.appendChild(titleLink);

    const meta = document.createElement('div');
    meta.className = 'news-meta';
    const source = document.createElement('span');
    source.className = 'mono news-source';
    source.textContent = item.source;
    meta.appendChild(source);
    const time = document.createElement('time');
    time.className = 'mono';
    time.dateTime = item.date;
    time.textContent = formatDate(item.date);
    meta.appendChild(time);
    article.appendChild(meta);

    return article;
  }

  // Recomputes currentFiltered from the fetched index for the active group + query.
  async function refilter() {
    if (hint) hint.textContent = 'Loading full archive…';
    const records = await loadIndex();
    const terms = splitTerms(normalize(query));
    currentFiltered = records.filter(item => {
      if (activeGroup !== 'all' && item.group !== activeGroup) return false;
      if (terms.length === 0) return true;
      return matchesTerms(item.searchText, terms);
    });
  }

  function paintPage() {
    const total = currentFiltered.length;
    const pages = Math.max(1, Math.ceil(total / NEWS_PAGE_SIZE));
    if (page > pages) page = pages;
    const start = (page - 1) * NEWS_PAGE_SIZE;
    const shown = currentFiltered.slice(start, start + NEWS_PAGE_SIZE);

    if (feed) {
      feed.innerHTML = '';
      shown.forEach(item => feed.appendChild(renderArticleEl(item)));
    }
    if (emptyEl) emptyEl.hidden = total > 0;
    if (hint) {
      hint.textContent = total
        ? `${total} article${total === 1 ? '' : 's'}${pages > 1 ? ` · page ${page} of ${pages}` : ''}`
        : '';
    }
    renderPager(pages);
  }

  // The first-ever interaction (of any kind) has to populate currentFiltered before
  // anything can be painted; later interactions that don't touch group/query (i.e.
  // a bare page click) just reuse what's already there.
  async function ensureFiltered() {
    if (!interacted) {
      interacted = true;
      await refilter();
    }
  }

  // Build the page numbers to show: always first + last, plus a window around the
  // current page, with gaps ("…") collapsing the rest.
  function pageWindow(pages: number, current: number): (number | 'gap')[] {
    const keep = new Set<number>([1, pages, current, current - 1, current + 1]);
    const nums = [...keep].filter(p => p >= 1 && p <= pages).sort((a, b) => a - b);
    const out: (number | 'gap')[] = [];
    let prev = 0;
    for (const p of nums) {
      if (p - prev > 1) out.push('gap');
      out.push(p);
      prev = p;
    }
    return out;
  }

  function renderPager(pages: number) {
    if (!pager) return;
    pager.innerHTML = '';
    if (pages <= 1) return;

    const btn = (label: string, opts: { target?: number; active?: boolean; disabled?: boolean; gap?: boolean }) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'page-btn' + (opts.active ? ' active' : '') + (opts.gap ? ' gap' : '');
      b.textContent = label;
      if (opts.gap || opts.disabled) {
        b.disabled = true;
      } else {
        b.addEventListener('click', async () => {
          await ensureFiltered();
          page = opts.target!;
          paintPage();
          feed?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
      pager.appendChild(b);
    };

    btn('‹', { target: page - 1, disabled: page === 1 });
    for (const p of pageWindow(pages, page)) {
      if (p === 'gap') btn('…', { gap: true });
      else btn(String(p), { target: p, active: p === page });
    }
    btn('›', { target: page + 1, disabled: page === pages });
  }

  // Any query/group change always recomputes the filtered set (unlike a bare page
  // click, which reuses it) and resets to page 1.
  async function applyFilter() {
    interacted = true;
    page = 1;
    await refilter();
    if (clearBtn) clearBtn.hidden = !normalize(query);
    paintPage();
  }

  searchInput?.addEventListener('input', () => { query = searchInput.value; applyFilter(); });
  searchForm?.addEventListener('submit', event => {
    event.preventDefault();
    query = searchInput?.value ?? '';
    applyFilter();
  });
  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    query = '';
    applyFilter();
    searchInput?.focus();
  });

  // Category tabs — switch the active group, keep any live search query applied.
  groupTabEls.forEach(tab => {
    tab.addEventListener('click', () => {
      activeGroup = tab.dataset.group ?? 'all';
      groupTabEls.forEach(t => {
        const on = t === tab;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      applyFilter();
    });
  });

  // The server-rendered NEWS_PAGE_SIZE articles above ARE the initial article-list
  // paint — no article fetch/render needed yet. But the pager still needs to exist
  // immediately (from the total baked into data-total), or a fresh visitor would have
  // no "page 2" button to click at all until they'd already searched/tabbed once.
  // Clicking any of these initial buttons still goes through ensureFiltered() above,
  // which fetches + filters for real before painting.
  const pagesInitial = Math.max(1, Math.ceil(totalInitial / NEWS_PAGE_SIZE));
  if (hint) {
    hint.textContent = `${totalInitial} article${totalInitial === 1 ? '' : 's'}` +
      (pagesInitial > 1 ? ` · page 1 of ${pagesInitial}` : '');
  }
  renderPager(pagesInitial);
</script>

<style>
  .news-section { margin-top: var(--gap-md); }

  /* Category filter tabs (always server-rendered, never recreated by script) */
  .group-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .group-tab {
    border: var(--border);
    border-radius: 0;
    background: var(--card);
    color: var(--ink-soft);
    padding: 7px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    cursor: pointer;
    line-height: 1;
  }

  .group-tab:hover:not(.active) { border-color: var(--teal); color: var(--ink); }

  .group-tab.active {
    background: var(--teal);
    color: #fff;
    border-color: var(--teal);
    cursor: default;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 20px;
    border-bottom: var(--border);
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    color: var(--ink-faint);
    pointer-events: none;
  }

  .news-search {
    appearance: none;
    border: var(--border);
    border-radius: 0;
    background: var(--card);
    padding: 8px 32px 8px 32px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--ink);
    min-width: 240px;
    outline: none;
  }

  .news-search:focus { border-color: var(--teal); }

  .news-search::-webkit-search-cancel-button { display: none; }

  .search-clear {
    position: absolute;
    right: 8px;
    background: none;
    border: none;
    padding: 0;
    font-size: 10px;
    color: var(--ink-faint);
    cursor: pointer;
    line-height: 1;
  }

  .search-clear:hover { color: var(--ink); }

  .search-submit {
    border: var(--border);
    border-radius: 0;
    background: var(--teal);
    color: #fff;
    padding: 9px 14px;
    font-size: 11px;
    font-family: var(--font-mono);
    cursor: pointer;
    letter-spacing: 0.04em;
  }

  .search-submit:hover,
  .search-submit:focus-visible {
    background: var(--ink);
  }

  .filter-hint {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* :global(...) below: the initial NEWS_PAGE_SIZE articles are server-rendered (and
     would get this scoping automatically), but every article past that is built by
     the client script via document.createElement — script-created elements never
     receive Astro's scoped data-astro-cid-* attribute, so an un-escaped selector here
     would silently fail to style them (and, previously, the pager buttons — see
     below). :global() makes these rules match by class regardless of how the element
     was created, so server-rendered and script-rendered cards look identical. */
  :global(.news-item) {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.news-tags) {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  :global(.news-cat) {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
    background: color-mix(in srgb, var(--teal) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--teal) 28%, transparent);
    padding: 3px 7px;
    line-height: 1;
  }

  :global(.news-title) {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
    max-width: 72ch;
    text-decoration: none;
  }

  :global(.news-title:hover) { text-decoration: underline; color: var(--teal); }

  :global(.news-meta) {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  :global(.news-source) { color: var(--ink-soft); }

  .news-empty { padding: 40px 0; color: var(--ink-faint); font-size: 12px; }

  /* Pagination — always script-rendered, so :global() here fixes a pre-existing bug
     (these buttons were likely unstyled even before this change). */
  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
  }

  .pager:empty { display: none; }

  :global(.page-btn) {
    min-width: 32px;
    border: var(--border);
    background: var(--card);
    color: var(--ink-soft);
    padding: 7px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    cursor: pointer;
  }

  :global(.page-btn:hover:not(:disabled):not(.active)) {
    border-color: var(--teal);
    color: var(--ink);
  }

  :global(.page-btn.active) {
    background: var(--teal);
    color: #fff;
    border-color: var(--teal);
    cursor: default;
  }

  :global(.page-btn:disabled) { cursor: default; }

  :global(.page-btn.gap) {
    border: none;
    background: none;
    color: var(--ink-faint);
    min-width: 0;
    padding: 7px 2px;
  }
</style>
