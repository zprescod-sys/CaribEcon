---
// Publications index — browsable list of reports with summaries + links out.
import type { PublicationsData } from '../../lib/types';

interface Props {
  publications: PublicationsData;
}

const { publications } = Astro.props;

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
}

const sortedPubs = [...publications].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<div class="pub-index">
  {sortedPubs.map(pub => {
    const countries = Array.isArray(pub.country) ? pub.country : [pub.country];
    const isRegional = countries.includes('REGION');
    return (
      <article class="pub-item">
        <div class="pub-meta">
          <span class="badge">{pub.type}</span>
          <time class="mono" datetime={pub.date}>{formatDate(pub.date)}</time>
          <span class="mono pub-body">{pub.body}</span>
          {!isRegional && countries.map(c => (
            <span class="badge">{c}</span>
          ))}
          {isRegional && <span class="badge">Regional</span>}
        </div>

        <a
          href={pub.url}
          target="_blank"
          rel="noopener noreferrer"
          class="pub-title"
        >
          {pub.title}
          <span class="pub-link-icon" aria-hidden="true">↗</span>
        </a>

        <p class="pub-summary">{pub.summary}</p>
      </article>
    );
  })}
</div>

<style>
  .pub-index {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: var(--gap-md);
  }

  .pub-item {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pub-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pub-body { color: var(--ink-faint); font-size: 10px; letter-spacing: 0.04em; }

  .pub-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.3;
    max-width: 72ch;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .pub-title:hover { color: var(--teal); text-decoration: underline; }

  .pub-link-icon {
    font-size: 12px;
    color: var(--ink-faint);
    flex-shrink: 0;
  }

  .pub-summary {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: 72ch;
  }
</style>
