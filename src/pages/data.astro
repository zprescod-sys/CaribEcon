---
import Shell             from '../layouts/Shell.astro';
import ChartControls     from '../components/charts/ChartControls.astro';
import LineChart         from '../components/charts/LineChart.astro';
import BudgetPie         from '../components/charts/BudgetPie.astro';
import CountryCarousel   from '../components/data/CountryCarousel.astro';
import type { CountrySnapshotData, SnapshotRow } from '../components/data/CountrySnapshot.astro';
import InsightCallout    from '../components/data/InsightCallout.astro';
import YearInFocusPanel  from '../components/data/YearInFocusPanel.astro';
import {
  getCountries,
  getSeries,
  getIndicatorAllCountries,
  getBudget,
} from '../lib/dataHub';

// Initial data: all series for the default indicator across all countries
const allSeries = getIndicatorAllCountries('gdp_growth');
const gyBudget  = getBudget('GY', 2024);
const ttBudget  = getBudget('TT', 2024);

// ── Country snapshots for the header carousel ──────────────────────────────
// Lead indicator first; the rest render as supporting rows.
const SNAPSHOT_INDICATORS = ['gdp_growth', 'inflation', 'govt_debt', 'fdi_inflows'];

// Compact number: thousands get separators; percentages keep one decimal,
// currency amounts round to whole numbers
const fmtNum = (v: number, decimal = true) =>
  Math.abs(v) >= 1000 ? Math.round(v).toLocaleString('en-US')
  : decimal ? v.toFixed(1) : String(Math.round(v));

// Latest point + delta vs the prior year for one country/indicator
function snapshotRow(country: string, indicator: string): SnapshotRow | null {
  const s = getSeries(country, indicator);
  if (!s) return null;
  const pts  = s.series.filter(p => p.value !== null);
  const last = pts[pts.length - 1];
  const prev = pts[pts.length - 2];
  if (!last) return null;

  const isPct  = s.unit.startsWith('%');
  const delta  = prev ? (last.value as number) - (prev.value as number) : null;

  return {
    label:      s.indicatorLabel,
    value:      `${fmtNum(last.value as number, isPct)}${isPct ? '%' : ''}`,
    unitSuffix: isPct ? '' : s.unit,
    year:       last.year,
    delta:      delta === null ? null
                : `${delta >= 0 ? '+' : '−'}${fmtNum(Math.abs(delta), isPct)}${isPct ? 'pp' : ''}`,
    deltaDir:   delta === null ? null : delta >= 0 ? 'pos' : 'neg',
    vsYear:     prev?.year ?? null,
    flag:       last.type !== 'actual' ? (last.type as 'estimate' | 'projection') : null,
  };
}

// One snapshot per country in the hub — adding a country's data just works
const snapshots: CountrySnapshotData[] = getCountries().flatMap(c => {
  const [lead, ...rows] = SNAPSHOT_INDICATORS
    .map(slug => snapshotRow(c.code, slug))
    .filter((r): r is SnapshotRow => r !== null);
  if (!lead) return [];
  const sources = [...new Set(
    SNAPSHOT_INDICATORS.map(slug => getSeries(c.code, slug)?.sourceOrg).filter(Boolean)
  )].join(' · ');
  return [{ code: c.code, name: c.name, flag: c.flag, lead, rows, sources }];
});
---

<Shell
  title="Data"
  description="Explore Caribbean economic indicators — GDP, inflation, unemployment, FDI, government debt, and budgets."
>
  <div class="page-wrapper data-page">

    <!-- ── Page header ──────────────────────────────────────── -->
    <header class="page-header fade-up fade-up-1">
      <span class="eyebrow">Economic Data</span>
      <h1 class="page-title">Chart Explorer</h1>
      <p class="page-sub">
        Select countries and indicators. Click any year for a key-event snapshot.
        Data sourced from IMF, World Bank, UNCTAD, and national sources.
        Estimates and projections are indicated.
      </p>
    </header>

    <!-- ── Country snapshot carousel ────────────────────────── -->
    <section class="fade-up fade-up-2">
      <CountryCarousel snapshots={snapshots} />
    </section>

    <!-- ── Chart controls + line chart ─────────────────────── -->
    <section class="chart-section fade-up fade-up-3">
      <ChartControls />
      <LineChart initialSeries={allSeries} initialIndicator="gdp_growth" />
      <YearInFocusPanel />
    </section>

    <!-- ── Insight ──────────────────────────────────────────── -->
    <InsightCallout
      text="Guyana's 57.8% real GDP growth in 2022 — the world's fastest that year — reflects the rapid ramp-up of the Stabroek Block. The structural divergence between Guyana's oil-led expansion and Trinidad & Tobago's gradual post-COVID recovery is the defining macroeconomic dynamic in the Caribbean this decade."
      accentColor="gold"
    />

    <!-- ── Budget section (tinted band) ─────────────────────── -->
    <section class="budget-section">
      <span class="eyebrow">Budget Breakdown</span>
      <h2 class="section-heading">2024 Budget Allocation</h2>
      <p class="section-sub">Click any segment to see key projects and initiatives.</p>

      <div class="two-col budget-grid">
        {gyBudget  && <BudgetPie budget={gyBudget}  />}
        {ttBudget  && <BudgetPie budget={ttBudget}  />}
      </div>
    </section>

  </div>
</Shell>

<style>
  .data-page {
    padding-top: 36px;
    padding-bottom: 60px;
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .page-title { font-size: var(--text-page); margin: 6px 0 10px; }
  .page-sub   { font-size: 15px; color: var(--ink-soft); max-width: 68ch; }

  .section-heading { font-size: var(--text-section); margin: 8px 0 6px; }
  .section-sub     { font-size: 14px; color: var(--ink-soft); margin-bottom: 20px; }

  .chart-section {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Tinted full-bleed band so the page isn't flat white */
  .budget-section {
    background-color: var(--paper-warm);
    margin-inline: calc(-1 * var(--side-padding));
    padding: 36px var(--side-padding) 44px;
    border-top: 1px solid var(--line);
  }

  .budget-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-md);
  }

  @media (max-width: 820px) {
    .budget-grid { grid-template-columns: 1fr; }
  }
</style>
