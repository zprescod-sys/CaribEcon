---
import Shell         from '../layouts/Shell.astro';
import DailyBriefing from '../components/home/DailyBriefing.astro';
import RegionalChart  from '../components/home/RegionalChart.astro';
import { getNews, getCountries, getSeries } from '../lib/dataHub';
import type { Briefing, BriefingStat } from '../components/home/DailyBriefing.astro';

const names = Object.fromEntries(getCountries().map(c => [c.code, c.name]));

const TEAL = '#0c7a74', INK = '#16170f', MUTED = '#8a857a', NEG = '#b4543e';

function fmtDate(d: string) {
  // Format in UTC so an ISO date (parsed as UTC midnight) doesn't slip a day in
  // negative-offset timezones.
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
function typeFlag(t: string) {
  return t === 'projection' ? 'f' : t === 'estimate' ? 'e' : '';
}
function latestPoint(country: string, slug: string) {
  const s = getSeries(country, slug);
  if (!s) return null;
  const pts = s.series.filter(p => p.value !== null);
  const last = pts[pts.length - 1];
  return last ? { value: last.value as number, year: last.year, type: last.type } : null;
}

// Per-country key-indicators rail, pulled live from the hub. First four available win.
const STAT_SPECS = [
  { slug: 'gdp_growth',              label: 'GDP growth', kind: 'growth' as const },
  { slug: 'inflation',               label: 'Inflation',  kind: 'pct'    as const, color: MUTED },
  { slug: 'unemployment',            label: 'Unemployment', kind: 'pct'  as const, color: INK },
  { slug: 'gross_govt_debt_pct_gdp', label: 'Debt / GDP', kind: 'pct'    as const, color: INK },
  { slug: 'fdi',                     label: 'FDI',        kind: 'usd'    as const, color: INK },
];

function buildStats(country: string): BriefingStat[] {
  const out: BriefingStat[] = [];
  for (const spec of STAT_SPECS) {
    if (out.length >= 4) break;
    const p = latestPoint(country, spec.slug);
    if (!p) continue;
    if (spec.kind === 'growth') {
      const v = p.value;
      out.push({
        label: `${spec.label} · ${p.year}${typeFlag(p.type)}`,
        value: `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}%`,
        color: v >= 0 ? TEAL : NEG,
      });
    } else if (spec.kind === 'pct') {
      out.push({ label: spec.label, value: `${p.value.toFixed(1)}%`, color: spec.color! });
    } else {
      const v = p.value;
      out.push({
        label: spec.label,
        value: Math.abs(v) >= 1000 ? `$${(v / 1000).toFixed(1)}bn` : `$${Math.round(v)}mn`,
        color: spec.color!,
      });
    }
  }
  return out;
}

function buildDek(country: string, name: string, source: string) {
  const g = latestPoint(country, 'gdp_growth');
  const inf = latestPoint(country, 'inflation');
  if (!g) return `Latest reading from ${source}.`;
  const desc = g.value >= 0 ? `expanded ${g.value.toFixed(1)}%` : `contracted ${Math.abs(g.value).toFixed(1)}%`;
  const infPart = inf ? `, with inflation at ${inf.value.toFixed(1)}%` : '';
  return `${name}'s real GDP ${desc} in ${g.year}${typeFlag(g.type)}${infPart} — the macro backdrop to today's lead story.`;
}

// Build one briefing per recent news item; clicking the story repoints the lead.
const newsShown = getNews().slice(0, 6);
const briefings: Briefing[] = newsShown.map(n => {
  const isRegional = n.country === 'ALL' || Array.isArray(n.country);
  const code = Array.isArray(n.country) ? n.country[0] : (n.country as string);
  const name = isRegional ? 'Caribbean' : (names[code] ?? code);
  const stats = isRegional ? [] : buildStats(code);
  return {
    key: n.id,
    tag: isRegional ? 'Regional' : name,
    time: fmtDate(n.date),
    heading: n.title,
    dek: isRegional
      ? 'Pan-Caribbean coverage — 16 economies tracked across the IMF, World Bank and ECLAC data spine.'
      : buildDek(code, name, n.source),
    source: n.source,
    url: n.url,
    showRail: stats.length > 0,
    stats,
  };
});

const active = briefings[0];

const newsRows = newsShown.map((n, i) => ({
  key: n.id,
  tag: briefings[i].tag.toUpperCase(),
  title: n.title.length > 72 ? n.title.slice(0, 72).replace(/\s\S*$/, '') + '…' : n.title,
  meta: `${n.source} · ${fmtDate(n.date)}`,
}));

const explore = [
  { n: '01', href: '/data',         title: 'Chart Explorer',     desc: 'GDP, inflation, unemployment, FDI, debt — multi-country, multi-year.' },
  { n: '02', href: '/news',         title: 'Latest News',        desc: 'Caribbean economic and business news, filterable by country.' },
  { n: '03', href: '/publications', title: 'Research Index',     desc: 'IMF, World Bank, CDB and ECLAC reports with summaries.' },
  { n: '04', href: '/deals',        title: 'Investment & M&A',   desc: 'Major transactions, FDI deals and capital market activity.' },
];
---

<Shell
  title="Home"
  description="Caribbean Macro Almanac — daily briefing, regional GDP chart, and quick access to data, news, publications, and deals."
>
  <div class="home-frame">
    <div class="home-card">

      <!-- Daily briefing (repoints on news click) -->
      <DailyBriefing briefing={active} />

      <!-- Regional chart -->
      <div class="card-section">
        <RegionalChart baseYear={2018} />
      </div>

      <!-- Explore -->
      <div class="card-section">
        <div class="section-eyebrow mono">Explore</div>
        <div class="explore-grid">
          {explore.map(e => (
            <a href={e.href} class="explore-card">
              <div class="explore-num mono">{e.n}</div>
              <div class="explore-title">{e.title}</div>
              <div class="explore-desc">{e.desc}</div>
            </a>
          ))}
        </div>
      </div>

      <!-- Recent news -->
      <div class="card-section card-section-last">
        <div class="recent-head">
          <div class="section-eyebrow mono">Recent News</div>
          <span class="recent-hint">Tap a story to load its briefing ↑</span>
        </div>
        <div class="recent-list">
          {newsRows.map(n => (
            <button type="button" class="news-row" data-key={n.key}>
              <span class="news-row-main">
                <span class="news-tag mono">{n.tag}</span>
                <span class="news-title">{n.title}</span>
              </span>
              <span class="news-meta mono">{n.meta}</span>
            </button>
          ))}
        </div>
        <a href="/news" class="all-news">All News →</a>
      </div>

    </div>
  </div>

  <script type="application/json" id="briefings-data" set:html={JSON.stringify(briefings)}></script>
</Shell>

<script>
  type Stat = { label: string; value: string; color: string };
  type Briefing = {
    key: string; tag: string; time: string; heading: string; dek: string;
    source: string; url: string; showRail: boolean; stats: Stat[];
  };

  const raw = document.getElementById('briefings-data')?.textContent ?? '[]';
  const briefings: Briefing[] = JSON.parse(raw);
  const byKey = new Map(briefings.map(b => [b.key, b]));

  const $ = (id: string) => document.getElementById(id);

  function repoint(b: Briefing) {
    const set = (id: string, text: string) => { const el = $(id); if (el) el.textContent = text; };
    set('brief-tag', b.tag);
    set('brief-time', b.time);
    set('brief-heading', b.heading);
    set('brief-dek', b.dek);
    set('brief-source', b.source);
    set('rail-tag', b.tag);
    const link = $('brief-link') as HTMLAnchorElement | null;
    if (link) link.href = b.url;

    const rail = $('brief-rail');
    if (rail) {
      if (b.showRail) {
        rail.hidden = false;
        const stats = $('rail-stats');
        if (stats) {
          stats.innerHTML = b.stats.map(s =>
            `<div class="rail-row"><span class="rail-stat-label">${s.label}</span>` +
            `<span class="rail-stat-value" style="color:${s.color}">${s.value}</span></div>`
          ).join('');
        }
      } else {
        rail.hidden = true;
      }
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.news-row').forEach(row => {
    row.addEventListener('click', () => {
      const b = byKey.get(row.dataset.key ?? '');
      if (!b) return;
      document.querySelectorAll('.news-row').forEach(r => r.classList.remove('active'));
      row.classList.add('active');
      repoint(b);
      document.querySelector('.home-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<style>
  /* Warm, editorial home page — faithful to the Claude Design mock. Scoped here so
     the rest of the site keeps its existing (cool petrol) design tokens. */
  .home-frame {
    background: #e7e5df;
    padding: 40px 24px;
    margin: 0 calc(50% - 50vw);   /* full-bleed warm frame inside the shell */
  }

  .home-card {
    max-width: 1160px;
    margin: 0 auto;
    background: #faf9f5;
    border-radius: 4px;
    box-shadow: 0 18px 50px rgba(28, 29, 26, 0.16);
    overflow: hidden;
    color: #22231f;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }

  .card-section { padding: 38px 40px; border-bottom: 1px solid #e6e3da; }
  .card-section-last { border-bottom: none; padding-bottom: 40px; }

  .section-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #0c7a74;
    margin-bottom: 22px;
  }

  /* Explore */
  .explore-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }

  .explore-card {
    text-decoration: none; border-top: 2px solid #16170f; padding-top: 14px; display: block;
  }
  .explore-num { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #a8a496; margin-bottom: 8px; }
  .explore-title {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 18px; font-weight: 600; color: #16170f; margin-bottom: 6px;
  }
  .explore-desc { font-size: 13px; line-height: 1.55; color: #6f6e64; }
  .explore-card:hover .explore-title { color: #0c7a74; }

  /* Recent news */
  .recent-head {
    display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px;
  }
  .recent-head .section-eyebrow { margin-bottom: 0; }
  .recent-hint { font-size: 12px; color: #a8a496; }

  .recent-list { display: flex; flex-direction: column; }

  .news-row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 24px;
    padding: 14px 0; border-bottom: 1px solid #e6e3da; cursor: pointer;
    background: none; border-left: 0; border-right: 0; border-top: 0; width: 100%; text-align: left;
    font: inherit; color: inherit; transition: padding-left 0.12s ease;
  }
  .news-row:hover { padding-left: 6px; }
  .news-row.active { padding-left: 6px; }
  .news-row.active .news-title { color: #0c7a74; }

  .news-row-main { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
  .news-tag {
    font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 600;
    letter-spacing: 0.08em; color: #0c7a74; min-width: 70px;
  }
  .news-title { font-size: 15px; font-weight: 500; color: #22231f; }
  .news-meta { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #a8a496; white-space: nowrap; }

  .all-news {
    display: inline-block; margin-top: 22px; font-size: 13.5px; font-weight: 600;
    color: #0c7a74; text-decoration: none; border-bottom: 1.5px solid #0c7a74; padding-bottom: 2px;
  }

  @media (max-width: 820px) {
    .home-frame { padding: 24px 14px; }
    .card-section { padding: 28px 24px; }
    .explore-grid { grid-template-columns: repeat(2, 1fr); gap: 22px; }
    .news-meta { display: none; }
  }
</style>
