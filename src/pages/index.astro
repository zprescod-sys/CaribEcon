---
import Shell         from '../layouts/Shell.astro';
import DailyBriefing from '../components/home/DailyBriefing.astro';
import RegionalChart  from '../components/home/RegionalChart.astro';
import { getNews, getCountries, getSeries, getIndicatorAllCountries } from '../lib/dataHub';
import type { Briefing, BriefingStat } from '../components/home/DailyBriefing.astro';
import type { DataPointType, IndicatorSeries } from '../lib/types';

const names = Object.fromEntries(getCountries().map(c => [c.code, c.name]));

// Rail stat colours — petrol palette (EDDESIGN.md tokens).
const POS = '#2F7D5B', INK = '#0F231E', MUTED = '#4C5A54', NEG = '#B4543E';

function fmtDate(d: string) {
  // Format in UTC so an ISO date (parsed as UTC midnight) doesn't slip a day in
  // negative-offset timezones.
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
function typeFlag(t: string) {
  return t === 'projection' ? 'f' : t === 'estimate' ? 'e' : '';
}
function formatYearLabel(year: number | null, type?: DataPointType | string | null) {
  if (!year) return 'latest';
  return `${year}${typeFlag(type ?? '')}`;
}
function formatPercent(v: number | null, signed = false) {
  if (v === null) return 'Data unavailable';
  const sign = signed && v >= 0 ? '+' : signed && v < 0 ? '−' : '';
  return `${sign}${Math.abs(v).toFixed(1)}%`;
}
function formatUsdMillions(v: number | null) {
  if (v === null) return 'Data unavailable';
  const a = Math.abs(v);
  if (a >= 1000) return `US$${(v / 1000).toFixed(1)}B`;
  return `US$${v.toFixed(1)}m`;
}
function latestPoint(country: string, slug: string) {
  const s = getSeries(country, slug);
  if (!s) return null;
  const pts = s.series.filter(p => p.value !== null);
  const last = pts[pts.length - 1];
  return last ? { value: last.value as number, year: last.year, type: last.type } : null;
}
function getLatestAvailableValue(series: IndicatorSeries | undefined) {
  if (!series) return null;
  const pts = series.series.filter(p => p.value !== null);
  const last = pts[pts.length - 1];
  return last ? { series, value: last.value as number, year: last.year, type: last.type } : null;
}

function topLatestIndicator(indicator: string, exclude = new Set<string>()) {
  return getIndicatorAllCountries(indicator)
    .filter(s => !exclude.has(s.country))
    .map(s => getLatestAvailableValue(s))
    .filter((p): p is NonNullable<ReturnType<typeof getLatestAvailableValue>> => p !== null)
    .sort((a, b) => b.value - a.value)[0] ?? null;
}

function getGrowthLeader() {
  return topLatestIndicator('gdp_growth');
}

function getInflationWatch() {
  return topLatestIndicator('inflation');
}

function getDebtWatch() {
  return topLatestIndicator('gross_govt_debt_pct_gdp');
}

function getFdiLeaderExcludingOffshoreCenters() {
  return topLatestIndicator('fdi', new Set(['VG', 'KY']));
}

function getFiscalSignal() {
  const rows = getCountries().flatMap(country => {
    const fiscal = getSeries(country.code, 'fiscal_balance');
    const gdp = getSeries(country.code, 'nominal_gdp');
    if (!fiscal || !gdp) return [];

    const gdpByYear = new Map(gdp.series.filter(p => p.value !== null).map(p => [p.year, p]));
    const latest = [...fiscal.series]
      .reverse()
      .find(p => p.value !== null && gdpByYear.has(p.year));
    if (!latest) return [];

    const gdpPoint = gdpByYear.get(latest.year);
    if (!gdpPoint?.value) return [];

    return [{
      series: fiscal,
      value: ((latest.value as number) / gdpPoint.value) * 100,
      year: latest.year,
      type: latest.type,
    }];
  });

  return rows.sort((a, b) => b.value - a.value)[0] ?? null;
}

type PreviewCard = {
  key: string;
  icon: string;
  category: string;
  name: string;
  value: string;
  subtext: string;
  commentary: string;
  href?: string;
};

const growthLeader = getGrowthLeader();
const inflationWatch = getInflationWatch();
const debtWatch = getDebtWatch();
const fdiLeader = getFdiLeaderExcludingOffshoreCenters();
const fiscalSignal = getFiscalSignal();

const regionalPreviewCards: PreviewCard[] = [
  {
    key: 'growth-leader',
    icon: '↗',
    category: 'Growth Leader',
    name: growthLeader ? names[growthLeader.series.country] ?? growthLeader.series.country : 'Data unavailable',
    value: growthLeader ? formatPercent(growthLeader.value, true) : 'Data unavailable',
    subtext: growthLeader ? `Real GDP growth · ${formatYearLabel(growthLeader.year, growthLeader.type)}` : 'Real GDP growth · latest',
    commentary: growthLeader?.series.country === 'GY'
      ? 'Resource-led expansion remains the region’s clearest outlier.'
      : 'Fastest real GDP expansion among tracked economies.',
  },
  {
    key: 'inflation-watch',
    icon: '%',
    category: 'Inflation Watch',
    name: inflationWatch ? names[inflationWatch.series.country] ?? inflationWatch.series.country : 'Data unavailable',
    value: inflationWatch ? formatPercent(inflationWatch.value) : 'Data unavailable',
    subtext: inflationWatch ? `CPI inflation · ${formatYearLabel(inflationWatch.year, inflationWatch.type)}` : 'CPI inflation · latest',
    commentary: 'Above the regional median as price pressures persist.',
  },
  {
    key: 'debt-watch',
    icon: '▥',
    category: 'Debt Watch',
    name: debtWatch ? names[debtWatch.series.country] ?? debtWatch.series.country : 'Data unavailable',
    value: debtWatch ? formatPercent(debtWatch.value) : 'Data unavailable',
    subtext: debtWatch ? `Public debt / GDP · ${formatYearLabel(debtWatch.year, debtWatch.type)}` : 'Public debt / GDP · latest',
    commentary: 'High debt levels continue to constrain fiscal space.',
  },
  {
    key: 'fdi-leader',
    icon: '◎',
    category: 'FDI Leader',
    name: fdiLeader ? names[fdiLeader.series.country] ?? fdiLeader.series.country : 'Data unavailable',
    value: fdiLeader ? formatUsdMillions(fdiLeader.value) : 'Data unavailable',
    subtext: fdiLeader ? `Net FDI inflows · ${formatYearLabel(fdiLeader.year, fdiLeader.type)}` : 'Net FDI inflows · latest',
    commentary: 'Largest inflow after excluding offshore financial centres.',
  },
  {
    key: 'fiscal-signal',
    icon: '⚖',
    category: 'Fiscal Signal',
    name: fiscalSignal ? names[fiscalSignal.series.country] ?? fiscalSignal.series.country : 'Data unavailable',
    value: fiscalSignal ? formatPercent(fiscalSignal.value, true) : 'Data unavailable',
    subtext: fiscalSignal ? `Fiscal balance / GDP · ${formatYearLabel(fiscalSignal.year, fiscalSignal.type)}` : 'Fiscal balance / GDP · latest',
    commentary: fiscalSignal && fiscalSignal.value >= 0
      ? 'One of the few economies with a fiscal surplus.'
      : 'Fiscal position remains under pressure.',
  },
];

// Per-country key-indicators rail, pulled live from the hub. First four available win.
const STAT_SPECS = [
  { slug: 'gdp_growth',              label: 'GDP growth', kind: 'growth' as const },
  { slug: 'inflation',               label: 'Inflation',  kind: 'pct'    as const, color: MUTED },
  { slug: 'unemployment',            label: 'Unemployment', kind: 'pct'  as const, color: INK },
  { slug: 'gross_govt_debt_pct_gdp', label: 'Debt / GDP', kind: 'pct'    as const, color: INK },
  { slug: 'fdi',                     label: 'Net FDI',    kind: 'usd'    as const, color: INK },
];

function buildStats(country: string): BriefingStat[] {
  const out: BriefingStat[] = [];
  for (const spec of STAT_SPECS) {
    if (out.length >= 4) break;
    const p = latestPoint(country, spec.slug);
    if (!p) continue;
    if (spec.kind === 'growth') {
      const v = p.value;
      out.push({
        label: `${spec.label} · ${p.year}${typeFlag(p.type)}`,
        value: `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}%`,
        color: v >= 0 ? POS : NEG,
      });
    } else if (spec.kind === 'pct') {
      out.push({ label: spec.label, value: `${p.value.toFixed(1)}%`, color: spec.color! });
    } else {
      const v = p.value;
      out.push({
        label: spec.label,
        value: Math.abs(v) >= 1000 ? `$${(v / 1000).toFixed(1)}bn` : `$${Math.round(v)}mn`,
        color: spec.color!,
      });
    }
  }
  return out;
}

function buildDek(country: string, name: string, source: string) {
  const g = latestPoint(country, 'gdp_growth');
  const inf = latestPoint(country, 'inflation');
  if (!g) return `Latest reading from ${source}.`;
  const desc = g.value >= 0 ? `expanded ${g.value.toFixed(1)}%` : `contracted ${Math.abs(g.value).toFixed(1)}%`;
  const infPart = inf ? `, with inflation at ${inf.value.toFixed(1)}%` : '';
  return `${name}'s real GDP ${desc} in ${g.year}${typeFlag(g.type)}${infPart} — the macro backdrop to today's lead story.`;
}

// Build one briefing per recent news item; clicking the story repoints the lead.
// Home shows the 6 most recent; the full archive lives on /news (paginated).
const newsShown = getNews().slice(0, 6);
const briefings: Briefing[] = newsShown.map(n => {
  const isRegional = n.country === 'ALL' || Array.isArray(n.country);
  const code = Array.isArray(n.country) ? n.country[0] : (n.country as string);
  const name = isRegional ? 'Caribbean' : (names[code] ?? code);
  const stats = isRegional ? [] : buildStats(code);
  return {
    key: n.id,
    tag: isRegional ? 'Regional' : name,
    time: fmtDate(n.date),
    heading: n.title,
    dek: isRegional
      ? 'Pan-Caribbean coverage — 16 economies tracked across the IMF, World Bank and ECLAC data spine.'
      : buildDek(code, name, n.source),
    source: n.source,
    url: n.url,
    showRail: stats.length > 0,
    stats,
  };
});

const active = briefings[0];
const regionalPreviewUpdated = newsShown[0]?.date ? fmtDate(newsShown[0].date) : null;

const newsRows = newsShown.map((n, i) => ({
  key: n.id,
  tag: briefings[i].tag.toUpperCase(),
  title: n.title.length > 72 ? n.title.slice(0, 72).replace(/\s\S*$/, '') + '…' : n.title,
  meta: `${n.source} · ${fmtDate(n.date)}`,
}));

const explore = [
  { n: '01', href: '/data',         title: 'Chart Explorer',     desc: 'GDP, inflation, unemployment, FDI, debt — multi-country, multi-year.' },
  { n: '02', href: '/news',         title: 'Latest News',        desc: 'Caribbean economic and business news, filterable by country.' },
  { n: '03', href: '/publications', title: 'Research Index',     desc: 'IMF, World Bank, CDB and ECLAC reports with summaries.' },
  { n: '04', href: '/deals',        title: 'Investment & M&A',   desc: 'Major transactions, FDI deals and capital market activity.' },
];
---

<Shell
  title="Home"
  description="Caribbean Macro Almanac — daily briefing, regional GDP chart, and quick access to data, news, publications, and deals."
>
  <div class="home-frame">
    <div class="home-card">

      <!-- Daily briefing (repoints on news click) -->
      <DailyBriefing briefing={active} />

      <!-- Regional dashboard preview -->
      <section class="dashboard-preview card-section" aria-labelledby="regional-dashboard-preview-title">
        <div class="dashboard-preview-head">
          <div>
            <h2 id="regional-dashboard-preview-title" class="dashboard-preview-heading">Regional Dashboard Preview</h2>
            <p class="dashboard-preview-title">A quick read on the Caribbean’s macro pulse across 16 economies.</p>
          </div>
          {regionalPreviewUpdated && (
            <p class="dashboard-updated mono" aria-label={`Homepage data updated ${regionalPreviewUpdated}`}>
              Updated {regionalPreviewUpdated}
            </p>
          )}
        </div>

        <div class="dashboard-card-grid">
          {regionalPreviewCards.map(card => {
            const Tag = card.href ? 'a' : 'article';
            return (
              <Tag href={card.href} class={`dashboard-card dashboard-card-${card.key}`} aria-label={card.href ? `Open ${card.category}: ${card.name}` : undefined}>
                <div class="dashboard-card-top">
                  <span class="dashboard-icon" aria-hidden="true">{card.icon}</span>
                  <span class="dashboard-category mono">{card.category}</span>
                </div>
                <h3 class="dashboard-card-name">{card.name}</h3>
                <p class="dashboard-card-value tabular">{card.value}</p>
                <p class="dashboard-card-sub">{card.subtext}</p>
                <div class="dashboard-divider" aria-hidden="true"></div>
                <p class="dashboard-card-note">{card.commentary}</p>
              </Tag>
            );
          })}
        </div>

        <div class="dashboard-actions">
          <a href="/data" class="all-news" aria-label="Explore the full data explorer">Explore full data explorer →</a>
          <p class="dashboard-source mono">
            Sources: IMF WEO, World Bank WDI, UNCTAD and national sources.
          </p>
        </div>
      </section>

      <!-- Regional chart -->
      <div class="card-section">
        <RegionalChart baseYear={2018} />
      </div>

      <!-- Explore -->
      <div class="card-section">
        <div class="section-eyebrow mono">Explore</div>
        <div class="explore-grid">
          {explore.map(e => (
            <a href={e.href} class="explore-card">
              <div class="explore-num mono">{e.n}</div>
              <div class="explore-title">{e.title}</div>
              <div class="explore-desc">{e.desc}</div>
            </a>
          ))}
        </div>
      </div>

      <!-- Recent news -->
      <div class="card-section card-section-last">
        <div class="recent-head">
          <div class="section-eyebrow mono">Recent News</div>
          <span class="recent-hint">Tap a story to load its briefing ↑</span>
        </div>
        <div class="recent-list">
          {newsRows.map(n => (
            <button type="button" class="news-row" data-key={n.key}>
              <span class="news-row-main">
                <span class="news-tag mono">{n.tag}</span>
                <span class="news-title">{n.title}</span>
              </span>
              <span class="news-meta mono">{n.meta}</span>
            </button>
          ))}
        </div>
        <a href="/news" class="all-news">All News →</a>
      </div>

    </div>
  </div>

  <script type="application/json" id="briefings-data" set:html={JSON.stringify(briefings)}></script>
</Shell>

<script>
  type Stat = { label: string; value: string; color: string };
  type Briefing = {
    key: string; tag: string; time: string; heading: string; dek: string;
    source: string; url: string; showRail: boolean; stats: Stat[];
  };

  const raw = document.getElementById('briefings-data')?.textContent ?? '[]';
  const briefings: Briefing[] = JSON.parse(raw);
  const byKey = new Map(briefings.map(b => [b.key, b]));

  const $ = (id: string) => document.getElementById(id);

  function repoint(b: Briefing) {
    const set = (id: string, text: string) => { const el = $(id); if (el) el.textContent = text; };
    set('brief-tag', b.tag);
    set('brief-time', b.time);
    set('brief-heading', b.heading);
    set('brief-dek', b.dek);
    set('brief-source', b.source);
    set('rail-tag', b.tag);
    const link = $('brief-link') as HTMLAnchorElement | null;
    if (link) link.href = b.url;

    const rail = $('brief-rail');
    if (rail) {
      if (b.showRail) {
        rail.hidden = false;
        const stats = $('rail-stats');
        if (stats) {
          stats.innerHTML = b.stats.map(s =>
            `<div class="rail-row"><span class="rail-stat-label">${s.label}</span>` +
            `<span class="rail-stat-value" style="color:${s.color}">${s.value}</span></div>`
          ).join('');
        }
      } else {
        rail.hidden = true;
      }
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.news-row').forEach(row => {
    row.addEventListener('click', () => {
      const b = byKey.get(row.dataset.key ?? '');
      if (!b) return;
      document.querySelectorAll('.news-row').forEach(r => r.classList.remove('active'));
      row.classList.add('active');
      repoint(b);
      document.querySelector('.home-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<style>
  /* Home page — petrol-and-gold system (EDDESIGN.md + Caribbean Almanac v2 mock).
     Hard edges, no shadows, no rounded corners. Reads from the shared design tokens. */
  /* No card/frame box — content sits directly on the shared page background (--paper),
     consistent with every other page. Sections are separated by hairline rules only. */
  .home-frame {
    background: transparent;
    padding: 8px 0 0;
  }

  .home-card {
    max-width: var(--max-width);
    margin: 0 auto;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-body);
  }

  .card-section { padding: 44px 40px; border-bottom: 1px solid var(--line); }
  .card-section-last { border-bottom: none; padding-bottom: 46px; }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--teal);
    margin-bottom: 24px;
  }

  /* Regional dashboard preview */
  .dashboard-preview {
    padding-top: 40px;
    padding-bottom: 34px;
  }

  .dashboard-preview-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 24px;
  }

  .dashboard-preview-heading {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    line-height: var(--lh-tight);
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .dashboard-preview-title {
    font-size: 14px;
    color: var(--ink-soft);
    margin-top: 5px;
    max-width: 58ch;
  }

  .dashboard-updated {
    white-space: nowrap;
    color: var(--ink-faint);
    margin-bottom: 2px;
  }

  .dashboard-card-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }

  .dashboard-card {
    display: flex;
    min-height: 218px;
    flex-direction: column;
    padding: 18px 16px 16px;
    border: 1px solid rgba(9, 78, 60, 0.12);
    border-radius: 16px;
    background:
      linear-gradient(145deg, rgba(236, 238, 232, 0.99) 0%, rgba(235, 238, 232, 0.96) 58%, rgba(226, 233, 225, 0.42) 100%),
      var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.16s ease, border-color 0.16s ease, background-color 0.16s ease;
  }

  .dashboard-card:hover {
    border-color: rgba(9, 78, 60, 0.2);
    background:
      linear-gradient(145deg, rgba(236, 238, 232, 1) 0%, rgba(235, 238, 232, 0.97) 56%, rgba(222, 231, 222, 0.5) 100%),
      var(--paper);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .dashboard-card-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .dashboard-icon {
    display: inline-flex;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(14, 94, 78, 0.11);
    color: var(--teal-deep);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    line-height: 1;
  }

  .dashboard-category {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--teal-deep);
  }

  .dashboard-card-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 12px;
    min-height: 38px;
  }

  .dashboard-card-value {
    font-family: var(--font-display);
    font-size: clamp(28px, 2.45vw, 34px);
    font-weight: 700;
    line-height: 1;
    color: var(--teal-deep);
    letter-spacing: 0;
    margin-bottom: 10px;
    overflow-wrap: anywhere;
  }

  .dashboard-card-sub {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink);
    line-height: 1.35;
  }

  .dashboard-divider {
    height: 1px;
    background: rgba(9, 78, 60, 0.12);
    margin: 13px 0 12px;
  }

  .dashboard-card-note {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-soft);
    line-height: 1.5;
    max-width: none;
  }

  .dashboard-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
    text-align: center;
  }

  .dashboard-actions .all-news {
    margin-top: 0;
  }

  .dashboard-source {
    max-width: 82ch;
    color: var(--ink-faint);
    line-height: 1.45;
  }

  /* Explore — quick-link cards: 2px ink top rule, mono index, Bricolage title */
  .explore-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }

  .explore-card {
    text-decoration: none; border-top: 2px solid var(--ink); padding-top: 14px; display: block;
  }
  .explore-num { font-family: var(--font-mono); font-size: 11px; color: var(--ink-faint); margin-bottom: 9px; }
  .explore-title {
    font-family: var(--font-display);
    font-size: 18px; font-weight: 700; color: var(--ink); margin-bottom: 6px;
  }
  .explore-desc { font-size: 13px; line-height: 1.55; color: var(--ink-soft); }
  .explore-card:hover .explore-title { color: var(--teal); }

  /* Recent news */
  .recent-head {
    display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16px;
  }
  .recent-head .section-eyebrow { margin-bottom: 0; }
  .recent-hint { font-size: 12px; color: var(--ink-faint); }

  .recent-list { display: flex; flex-direction: column; }

  .news-row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 24px;
    padding: 14px 0; border-bottom: 1px solid var(--line); cursor: pointer;
    background: none; border-left: 0; border-right: 0; border-top: 0; width: 100%; text-align: left;
    font: inherit; color: inherit; transition: padding-left 0.12s ease;
  }
  .news-row:hover { padding-left: 6px; }
  .news-row.active { padding-left: 6px; }
  .news-row.active .news-title { color: var(--teal); }

  .news-row-main { display: flex; align-items: baseline; gap: 14px; min-width: 0; }
  .news-tag {
    font-family: var(--font-mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.06em; color: var(--teal); min-width: 72px;
  }
  .news-title { font-size: 15px; font-weight: 500; color: var(--ink); }
  .news-meta { font-family: var(--font-mono); font-size: 11px; color: var(--ink-faint); white-space: nowrap; }

  .all-news {
    display: inline-block; margin-top: 22px;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em;
    color: var(--teal); text-decoration: none; border-bottom: 2px solid var(--gold); padding-bottom: 3px;
  }
