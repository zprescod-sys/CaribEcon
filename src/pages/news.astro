---
import Shell    from '../layouts/Shell.astro';
import NewsFeed from '../components/news/NewsFeed.astro';
import { getNews } from '../lib/dataHub';
import { NEWS_PAGE_SIZE } from '../lib/newsSearch';

// Only the first page's worth renders as static HTML (fast first paint, no JS
// required to see real articles); paging past 1, tab-filtering, and search all read
// from the full archive via a background-fetched news-index.json instead — see
// src/components/news/NewsFeed.astro and src/pages/news-index.json.ts.
const allNews = getNews();
const news = allNews.slice(0, NEWS_PAGE_SIZE);
---

<Shell
  title="News"
  description="Latest Caribbean economic and business news, filterable by country."
>
  <div class="page-wrapper news-page">

    <header class="page-header fade-up fade-up-1">
      <span class="eyebrow">News</span>
      <h1 class="page-title">Caribbean News</h1>
      <p class="page-sub">
        Economic and business headlines across the Caribbean.
        Filter by country or browse all. Links open source publications.
      </p>
    </header>

    <section class="fade-up fade-up-2">
      <NewsFeed news={news} allNews={allNews} />
    </section>

    <div class="dataset-note card emphasis-teal fade-up">
      <span class="eyebrow">Dataset Note</span>
      <p>
        Headlines are pulled daily from Caribbean news RSS feeds and filtered to
        financial and economic coverage. Only headline, source, date and link are
        stored — follow a link to read the full article at its source.
      </p>
    </div>

  </div>
</Shell>

<style>
  .news-page {
    padding-top: 36px;
    padding-bottom: 60px;
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .page-title { font-size: var(--text-page); margin: 6px 0 10px; }
  .page-sub   { font-size: 15px; color: var(--ink-soft); max-width: 68ch; }

  .dataset-note {
    padding: 16px 20px;
    max-width: 600px;
  }

  .dataset-note p {
    font-size: 14px;
    color: var(--ink-soft);
    margin-top: 6px;
    line-height: 1.6;
  }
</style>
