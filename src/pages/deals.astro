---
import Shell          from '../layouts/Shell.astro';
import DealsHeadlines from '../components/deals/DealsHeadlines.astro';
import { getDeals }  from '../lib/dataHub';

const deals = getDeals();
---

<Shell
  title="Deals & Investment"
  description="Major M&A, FDI, and investment transactions across Caribbean economies."
>
  <div class="page-wrapper deals-page">

    <header class="page-header fade-up fade-up-1">
      <span class="eyebrow">Deals &amp; Investment</span>
      <h1 class="page-title">Transactions</h1>
      <p class="page-sub">
        Headline M&amp;A, FDI, bond, and concession deals across the Caribbean.
        All entries link to primary sources.
        Values are as reported; "undisclosed" where not publicly available.
      </p>
    </header>

    <div class="deals-meta-note mono fade-up">
      {deals.length} transactions · 2022–2024 · Sources: company announcements, Caribbean Business, Caribbean Journal
    </div>

    <section class="fade-up fade-up-2">
      <DealsHeadlines deals={deals} />
    </section>

  </div>
</Shell>

<style>
  .deals-page {
    padding-top: 36px;
    padding-bottom: 60px;
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .page-title { font-size: var(--text-page); margin: 6px 0 10px; }
  .page-sub   { font-size: 15px; color: var(--ink-soft); max-width: 68ch; }

  .deals-meta-note {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    margin-top: calc(-1 * var(--section-gap) + var(--gap-md));
  }
</style>
