# Copy this file to .env for local testing (never commit .env — it's already gitignored).
# node --env-file=.env scripts/build-feeds.mjs

ANTHROPIC_API_KEY=

# Server-side AI provider keys — shared research infrastructure (docs/ARCHITECTURE.md §4).
# None of these are read by the frozen /api/research; they back the planned /api/ask path.
# Base URLs for Nebius/MiniMax are deliberately NOT pre-filled — src/lib/ai/config.ts never
# guesses one. Get the real value from each provider's own dashboard/docs and set it here; until
# then that provider's roles resolve to null and fail closed (503), never a misrouted request.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=

# NoInfra's OpenAI-compatible inference endpoint — confirmed live 2026-08-17 against the real
# gateway (docs/NOINFRA_SPIKE.md), unlike Nebius/MiniMax above. config.ts pre-fills the base URL
# as a verified default; set NOINFRA_BASE_URL only to override it. Models observed live:
# multimodal (Kimi K3), small/fast (GLM-5.2), reasoning (GPT-OSS-120B).
NOINFRA_API_KEY=
NOINFRA_BASE_URL=

# Role -> provider/model mapping (ARCHITECTURE.md §4.5). Unset = that role fails closed, not a
# default guess. Each *_MODEL must be a real, live-validated model id on the chosen provider —
# never invented (see src/lib/ai/config.ts's header).
CARIBECON_INTERPRET_PROVIDER=
CARIBECON_INTERPRET_MODEL=
CARIBECON_PLAN_PROVIDER=
CARIBECON_PLAN_MODEL=
CARIBECON_SYNTHESIS_PROVIDER=
CARIBECON_SYNTHESIS_MODEL=
CARIBECON_VERIFY_PROVIDER=
CARIBECON_VERIFY_MODEL=

# Tavily web search/extract — plan-authorized external research tool (docs/ARCHITECTURE.md §3.2).
TAVILY_API_KEY=

# OpenClaw gateway — the NoInfra research runtime, reached by api/noinfraSpike.ts (Phase 0b).
# OPENCLAW_GATEWAY_TOKEN is OPERATOR-LEVEL access to the gateway: a holder can target agents
# other than the restricted caribecon-research one. Server-side Vercel env ONLY — never in the
# Excel bundle, never in a webpack DefinePlugin substitution, never logged. See docs/NOINFRA_SPIKE.md.
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
# The gateway-namespaced MCP tool name. Defaults to caribecon-research__caribecon_research;
# set this only if the live gateway reports a different prefix.
OPENCLAW_CARIBECON_TOOL=
# Client-side deadline for the gateway call, ms. Defaults to 25000 — under the route's 30s
# maxDuration so we fail first with an honest message. Tune once real latency is measured.
OPENCLAW_GATEWAY_TIMEOUT_MS=

# Shared token gating POST /api/research (the only endpoint that spends tokens). Must match
# the value set on the Vercel project AND the one baked into the Excel add-in at build time:
#   CARIBECON_RESEARCH_TOKEN=... npm run build:addin
# Unset on the server => /api/research returns 503 rather than serving unauthenticated.
# Unset at build time => the add-in simply hides its Ask tab.
CARIBECON_RESEARCH_TOKEN=
