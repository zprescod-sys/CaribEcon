# Copy this file to .env for local testing (never commit .env — it's already gitignored).
# node --env-file=.env scripts/build-feeds.mjs

ANTHROPIC_API_KEY=

# Server-side AI provider keys — shared research infrastructure (docs/ARCHITECTURE.md §4).
# None of these are read by the frozen /api/research; they back the planned /api/ask path.
NEBIUS_API_KEY=
MINIMAX_API_KEY=

# Tavily web search/extract — plan-authorized external research tool (docs/ARCHITECTURE.md §3.2).
TAVILY_API_KEY=

# Shared token gating POST /api/research (the only endpoint that spends tokens). Must match
# the value set on the Vercel project AND the one baked into the Excel add-in at build time:
#   CARIBECON_RESEARCH_TOKEN=... npm run build:addin
# Unset on the server => /api/research returns 503 rather than serving unauthenticated.
# Unset at build time => the add-in simply hides its Ask tab.
CARIBECON_RESEARCH_TOKEN=
