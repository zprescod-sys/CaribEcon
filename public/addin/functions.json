        {
            "description": "Any stored CaribEcon indicator, by slug, for a Caribbean economy in a given year.\nReturns stored values only — no forecasting, no cross-record calculation.",
            "id": "INDICATOR",
            "name": "INDICATOR",
            "parameters": [
                {
                    "description": "ISO-ish 2-letter code, e.g. \"GY\".",
                    "name": "country",
                    "type": "string"
                },
                {
                    "description": "CaribEcon indicator slug, e.g. \"inflation\".",
                    "name": "indicatorSlug",
                    "type": "string"
                },
                {
                    "description": "Calendar year, e.g. 2024.",
                    "name": "year",
                    "type": "number"
                }
            ],
            "result": {
                "type": "number"
            }
        },
        {
            "description": "A whole time series for one country and indicator, spilled as two columns: year, value.\nYears with no sourced value are omitted rather than returned as zero.",
            "id": "SERIES",
            "name": "SERIES",
            "parameters": [
                {
                    "description": "ISO-ish 2-letter code, e.g. \"GY\".",
                    "name": "country",
                    "type": "string"
                },
                {
                    "description": "CaribEcon indicator slug, e.g. \"gdp_growth\".",
                    "name": "indicatorSlug",
                    "type": "string"
                },
                {
                    "description": "First year to include. Omit for the earliest available.",
                    "name": "startYear",
                    "optional": true,
                    "type": "number"
                },
                {
                    "description": "Last year to include. Omit for the latest available.",
                    "name": "endYear",
                    "optional": true,
                    "type": "number"
                }
            ],
            "result": {
                "dimensionality": "matrix",
                "type": "number"
            }
