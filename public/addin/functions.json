{
    "allowCustomDataForDataTypeAny": true,
    "functions": [
        {
            "description": "Nominal GDP for a Caribbean economy in a given year, sourced from the CaribEcon hub.",
            "id": "GDP",
            "name": "GDP",
            "parameters": [
                {
                    "description": "ISO-ish 2-letter code, e.g. \"GY\".",
                    "name": "country",
                    "type": "string"
                },
                {
                    "description": "Calendar year, e.g. 2024.",
                    "name": "year",
                    "type": "number"
                }
            ],
            "result": {
                "type": "number"
            }
        },
        {
